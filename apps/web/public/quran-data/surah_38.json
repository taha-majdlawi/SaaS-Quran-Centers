{"number":38,"name":{"ar":"ص"},"revelation_place":{"ar":"مكية"},"verses_count":88,"verses":[{"number":1,"text":{"ar":"صٓۚ وَٱلۡقُرۡءَانِ ذِي ٱلذِّكۡرِ"},"juz":23,"page":453,"sajda":false},{"number":2,"text":{"ar":"بَلِ ٱلَّذِينَ كَفَرُواْ فِي عِزَّةٖ وَشِقَاقٖ"},"juz":23,"page":453,"sajda":false},{"number":3,"text":{"ar":"كَمۡ أَهۡلَكۡنَا مِن قَبۡلِهِم مِّن قَرۡنٖ فَنَادَواْ وَّلَاتَ حِينَ مَنَاصٖ"},"juz":23,"page":453,"sajda":false},{"number":4,"text":{"ar":"وَعَجِبُوٓاْ أَن جَآءَهُم مُّنذِرٞ مِّنۡهُمۡۖ وَقَالَ ٱلۡكَٰفِرُونَ هَٰذَا سَٰحِرٞ كَذَّابٌ"},"juz":23,"page":453,"sajda":false},{"number":5,"text":{"ar":"أَجَعَلَ ٱلۡأٓلِهَةَ إِلَٰهٗا وَٰحِدًاۖ إِنَّ هَٰذَا لَشَيۡءٌ عُجَابٞ"},"juz":23,"page":453,"sajda":false},{"number":6,"text":{"ar":"وَٱنطَلَقَ ٱلۡمَلَأُ مِنۡهُمۡ أَنِ ٱمۡشُواْ وَٱصۡبِرُواْ عَلَىٰٓ ءَالِهَتِكُمۡۖ إِنَّ هَٰذَا لَشَيۡءٞ يُرَادُ"},"juz":23,"page":453,"sajda":false},{"number":7,"text":{"ar":"مَا سَمِعۡنَا بِهَٰذَا فِي ٱلۡمِلَّةِ ٱلۡأٓخِرَةِ إِنۡ هَٰذَآ إِلَّا ٱخۡتِلَٰقٌ"},"juz":23,"page":453,"sajda":false},{"number":8,"text":{"ar":"أَءُنزِلَ عَلَيۡهِ ٱلذِّكۡرُ مِنۢ بَيۡنِنَاۚ بَلۡ هُمۡ فِي شَكّٖ مِّن ذِكۡرِيۚ بَل لَّمَّا يَذُوقُواْ عَذَابِ"},"juz":23,"page":453,"sajda":false},{"number":9,"text":{"ar":"أَمۡ عِندَهُمۡ خَزَآئِنُ رَحۡمَةِ رَبِّكَ ٱلۡعَزِيزِ ٱلۡوَهَّابِ"},"juz":23,"page":453,"sajda":false},{"number":10,"text":{"ar":"أَمۡ لَهُم مُّلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَاۖ فَلۡيَرۡتَقُواْ فِي ٱلۡأَسۡبَٰبِ"},"juz":23,"page":453,"sajda":false},{"number":11,"text":{"ar":"جُندٞ مَّا هُنَالِكَ مَهۡزُومٞ مِّنَ ٱلۡأَحۡزَابِ"},"juz":23,"page":453,"sajda":false},{"number":12,"text":{"ar":"كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوحٖ وَعَادٞ وَفِرۡعَوۡنُ ذُو ٱلۡأَوۡتَادِ"},"juz":23,"page":453,"sajda":false},{"number":13,"text":{"ar":"وَثَمُودُ وَقَوۡمُ لُوطٖ وَأَصۡحَٰبُ لۡـَٔيۡكَةِۚ أُوْلَـٰٓئِكَ ٱلۡأَحۡزَابُ"},"juz":23,"page":453,"sajda":false},{"number":14,"text":{"ar":"إِن كُلٌّ إِلَّا كَذَّبَ ٱلرُّسُلَ فَحَقَّ عِقَابِ"},"juz":23,"page":453,"sajda":false},{"number":15,"text":{"ar":"وَمَا يَنظُرُ هَـٰٓؤُلَآءِ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ مَّا لَهَا مِن فَوَاقٖ"},"juz":23,"page":453,"sajda":false},{"number":16,"text":{"ar":"وَقَالُواْ رَبَّنَا عَجِّل لَّنَا قِطَّنَا قَبۡلَ يَوۡمِ ٱلۡحِسَابِ"},"juz":23,"page":453,"sajda":false},{"number":17,"text":{"ar":"ٱصۡبِرۡ عَلَىٰ مَا يَقُولُونَ وَٱذۡكُرۡ عَبۡدَنَا دَاوُۥدَ ذَا ٱلۡأَيۡدِۖ إِنَّهُۥٓ أَوَّابٌ"},"juz":23,"page":454,"sajda":false},{"number":18,"text":{"ar":"إِنَّا سَخَّرۡنَا ٱلۡجِبَالَ مَعَهُۥ يُسَبِّحۡنَ بِٱلۡعَشِيِّ وَٱلۡإِشۡرَاقِ"},"juz":23,"page":454,"sajda":false},{"number":19,"text":{"ar":"وَٱلطَّيۡرَ مَحۡشُورَةٗۖ كُلّٞ لَّهُۥٓ أَوَّابٞ"},"juz":23,"page":454,"sajda":false},{"number":20,"text":{"ar":"وَشَدَدۡنَا مُلۡكَهُۥ وَءَاتَيۡنَٰهُ ٱلۡحِكۡمَةَ وَفَصۡلَ ٱلۡخِطَابِ"},"juz":23,"page":454,"sajda":false},{"number":21,"text":{"ar":"۞وَهَلۡ أَتَىٰكَ نَبَؤُاْ ٱلۡخَصۡمِ إِذۡ تَسَوَّرُواْ ٱلۡمِحۡرَابَ"},"juz":23,"page":454,"sajda":false},{"number":22,"text":{"ar":"إِذۡ دَخَلُواْ عَلَىٰ دَاوُۥدَ فَفَزِعَ مِنۡهُمۡۖ قَالُواْ لَا تَخَفۡۖ خَصۡمَانِ بَغَىٰ بَعۡضُنَا عَلَىٰ بَعۡضٖ فَٱحۡكُم بَيۡنَنَا بِٱلۡحَقِّ وَلَا تُشۡطِطۡ وَٱهۡدِنَآ إِلَىٰ سَوَآءِ ٱلصِّرَٰطِ"},"juz":23,"page":454,"sajda":false},{"number":23,"text":{"ar":"إِنَّ هَٰذَآ أَخِي لَهُۥ تِسۡعٞ وَتِسۡعُونَ نَعۡجَةٗ وَلِيَ نَعۡجَةٞ وَٰحِدَةٞ فَقَالَ أَكۡفِلۡنِيهَا وَعَزَّنِي فِي ٱلۡخِطَابِ"},"juz":23,"page":454,"sajda":false},{"number":24,"text":{"ar":"قَالَ لَقَدۡ ظَلَمَكَ بِسُؤَالِ نَعۡجَتِكَ إِلَىٰ نِعَاجِهِۦۖ وَإِنَّ كَثِيرٗا مِّنَ ٱلۡخُلَطَآءِ لَيَبۡغِي بَعۡضُهُمۡ عَلَىٰ بَعۡضٍ إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ وَقَلِيلٞ مَّا هُمۡۗ وَظَنَّ دَاوُۥدُ أَنَّمَا فَتَنَّـٰهُ فَٱسۡتَغۡفَرَ رَبَّهُۥ وَخَرَّۤ رَاكِعٗاۤ وَأَنَابَ۩"},"juz":23,"page":454,"sajda":{"obligatory":false}},{"number":25,"text":{"ar":"فَغَفَرۡنَا لَهُۥ ذَٰلِكَۖ وَإِنَّ لَهُۥ عِندَنَا لَزُلۡفَىٰ وَحُسۡنَ مَـَٔابٖ"},"juz":23,"page":454,"sajda":false},{"number":26,"text":{"ar":"يَٰدَاوُۥدُ إِنَّا جَعَلۡنَٰكَ خَلِيفَةٗ فِي ٱلۡأَرۡضِ فَٱحۡكُم بَيۡنَ ٱلنَّاسِ بِٱلۡحَقِّ وَلَا تَتَّبِعِ ٱلۡهَوَىٰ فَيُضِلَّكَ عَن سَبِيلِ ٱللَّهِۚ إِنَّ ٱلَّذِينَ يَضِلُّونَ عَن سَبِيلِ ٱللَّهِ لَهُمۡ عَذَابٞ شَدِيدُۢ بِمَا نَسُواْ يَوۡمَ ٱلۡحِسَابِ"},"juz":23,"page":454,"sajda":false},{"number":27,"text":{"ar":"وَمَا خَلَقۡنَا ٱلسَّمَآءَ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا بَٰطِلٗاۚ ذَٰلِكَ ظَنُّ ٱلَّذِينَ كَفَرُواْۚ فَوَيۡلٞ لِّلَّذِينَ كَفَرُواْ مِنَ ٱلنَّارِ"},"juz":23,"page":455,"sajda":false},{"number":28,"text":{"ar":"أَمۡ نَجۡعَلُ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ كَٱلۡمُفۡسِدِينَ فِي ٱلۡأَرۡضِ أَمۡ نَجۡعَلُ ٱلۡمُتَّقِينَ كَٱلۡفُجَّارِ"},"juz":23,"page":455,"sajda":false},{"number":29,"text":{"ar":"كِتَٰبٌ أَنزَلۡنَٰهُ إِلَيۡكَ مُبَٰرَكٞ لِّيَدَّبَّرُوٓاْ ءَايَٰتِهِۦ وَلِيَتَذَكَّرَ أُوْلُواْ ٱلۡأَلۡبَٰبِ"},"juz":23,"page":455,"sajda":false},{"number":30,"text":{"ar":"وَوَهَبۡنَا لِدَاوُۥدَ سُلَيۡمَٰنَۚ نِعۡمَ ٱلۡعَبۡدُ إِنَّهُۥٓ أَوَّابٌ"},"juz":23,"page":455,"sajda":false},{"number":31,"text":{"ar":"إِذۡ عُرِضَ عَلَيۡهِ بِٱلۡعَشِيِّ ٱلصَّـٰفِنَٰتُ ٱلۡجِيَادُ"},"juz":23,"page":455,"sajda":false},{"number":32,"text":{"ar":"فَقَالَ إِنِّيٓ أَحۡبَبۡتُ حُبَّ ٱلۡخَيۡرِ عَن ذِكۡرِ رَبِّي حَتَّىٰ تَوَارَتۡ بِٱلۡحِجَابِ"},"juz":23,"page":455,"sajda":false},{"number":33,"text":{"ar":"رُدُّوهَا عَلَيَّۖ فَطَفِقَ مَسۡحَۢا بِٱلسُّوقِ وَٱلۡأَعۡنَاقِ"},"juz":23,"page":455,"sajda":false},{"number":34,"text":{"ar":"وَلَقَدۡ فَتَنَّا سُلَيۡمَٰنَ وَأَلۡقَيۡنَا عَلَىٰ كُرۡسِيِّهِۦ جَسَدٗا ثُمَّ أَنَابَ"},"juz":23,"page":455,"sajda":false},{"number":35,"text":{"ar":"قَالَ رَبِّ ٱغۡفِرۡ لِي وَهَبۡ لِي مُلۡكٗا لَّا يَنۢبَغِي لِأَحَدٖ مِّنۢ بَعۡدِيٓۖ إِنَّكَ أَنتَ ٱلۡوَهَّابُ"},"juz":23,"page":455,"sajda":false},{"number":36,"text":{"ar":"فَسَخَّرۡنَا لَهُ ٱلرِّيحَ تَجۡرِي بِأَمۡرِهِۦ رُخَآءً حَيۡثُ أَصَابَ"},"juz":23,"page":455,"sajda":false},{"number":37,"text":{"ar":"وَٱلشَّيَٰطِينَ كُلَّ بَنَّآءٖ وَغَوَّاصٖ"},"juz":23,"page":455,"sajda":false},{"number":38,"text":{"ar":"وَءَاخَرِينَ مُقَرَّنِينَ فِي ٱلۡأَصۡفَادِ"},"juz":23,"page":455,"sajda":false},{"number":39,"text":{"ar":"هَٰذَا عَطَآؤُنَا فَٱمۡنُنۡ أَوۡ أَمۡسِكۡ بِغَيۡرِ حِسَابٖ"},"juz":23,"page":455,"sajda":false},{"number":40,"text":{"ar":"وَإِنَّ لَهُۥ عِندَنَا لَزُلۡفَىٰ وَحُسۡنَ مَـَٔابٖ"},"juz":23,"page":455,"sajda":false},{"number":41,"text":{"ar":"وَٱذۡكُرۡ عَبۡدَنَآ أَيُّوبَ إِذۡ نَادَىٰ رَبَّهُۥٓ أَنِّي مَسَّنِيَ ٱلشَّيۡطَٰنُ بِنُصۡبٖ وَعَذَابٍ"},"juz":23,"page":455,"sajda":false},{"number":42,"text":{"ar":"ٱرۡكُضۡ بِرِجۡلِكَۖ هَٰذَا مُغۡتَسَلُۢ بَارِدٞ وَشَرَابٞ"},"juz":23,"page":455,"sajda":false},{"number":43,"text":{"ar":"وَوَهَبۡنَا لَهُۥٓ أَهۡلَهُۥ وَمِثۡلَهُم مَّعَهُمۡ رَحۡمَةٗ مِّنَّا وَذِكۡرَىٰ لِأُوْلِي ٱلۡأَلۡبَٰبِ"},"juz":23,"page":456,"sajda":false},{"number":44,"text":{"ar":"وَخُذۡ بِيَدِكَ ضِغۡثٗا فَٱضۡرِب بِّهِۦ وَلَا تَحۡنَثۡۗ إِنَّا وَجَدۡنَٰهُ صَابِرٗاۚ نِّعۡمَ ٱلۡعَبۡدُ إِنَّهُۥٓ أَوَّابٞ"},"juz":23,"page":456,"sajda":false},{"number":45,"text":{"ar":"وَٱذۡكُرۡ عِبَٰدَنَآ إِبۡرَٰهِيمَ وَإِسۡحَٰقَ وَيَعۡقُوبَ أُوْلِي ٱلۡأَيۡدِي وَٱلۡأَبۡصَٰرِ"},"juz":23,"page":456,"sajda":false},{"number":46,"text":{"ar":"إِنَّآ أَخۡلَصۡنَٰهُم بِخَالِصَةٖ ذِكۡرَى ٱلدَّارِ"},"juz":23,"page":456,"sajda":false},{"number":47,"text":{"ar":"وَإِنَّهُمۡ عِندَنَا لَمِنَ ٱلۡمُصۡطَفَيۡنَ ٱلۡأَخۡيَارِ"},"juz":23,"page":456,"sajda":false},{"number":48,"text":{"ar":"وَٱذۡكُرۡ إِسۡمَٰعِيلَ وَٱلۡيَسَعَ وَذَا ٱلۡكِفۡلِۖ وَكُلّٞ مِّنَ ٱلۡأَخۡيَارِ"},"juz":23,"page":456,"sajda":false},{"number":49,"text":{"ar":"هَٰذَا ذِكۡرٞۚ وَإِنَّ لِلۡمُتَّقِينَ لَحُسۡنَ مَـَٔابٖ"},"juz":23,"page":456,"sajda":false},{"number":50,"text":{"ar":"جَنَّـٰتِ عَدۡنٖ مُّفَتَّحَةٗ لَّهُمُ ٱلۡأَبۡوَٰبُ"},"juz":23,"page":456,"sajda":false},{"number":51,"text":{"ar":"مُتَّكِـِٔينَ فِيهَا يَدۡعُونَ فِيهَا بِفَٰكِهَةٖ كَثِيرَةٖ وَشَرَابٖ"},"juz":23,"page":456,"sajda":false},{"number":52,"text":{"ar":"۞وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ أَتۡرَابٌ"},"juz":23,"page":456,"sajda":false},{"number":53,"text":{"ar":"هَٰذَا مَا تُوعَدُونَ لِيَوۡمِ ٱلۡحِسَابِ"},"juz":23,"page":456,"sajda":false},{"number":54,"text":{"ar":"إِنَّ هَٰذَا لَرِزۡقُنَا مَا لَهُۥ مِن نَّفَادٍ"},"juz":23,"page":456,"sajda":false},{"number":55,"text":{"ar":"هَٰذَاۚ وَإِنَّ لِلطَّـٰغِينَ لَشَرَّ مَـَٔابٖ"},"juz":23,"page":456,"sajda":false},{"number":56,"text":{"ar":"جَهَنَّمَ يَصۡلَوۡنَهَا فَبِئۡسَ ٱلۡمِهَادُ"},"juz":23,"page":456,"sajda":false},{"number":57,"text":{"ar":"هَٰذَا فَلۡيَذُوقُوهُ حَمِيمٞ وَغَسَّاقٞ"},"juz":23,"page":456,"sajda":false},{"number":58,"text":{"ar":"وَءَاخَرُ مِن شَكۡلِهِۦٓ أَزۡوَٰجٌ"},"juz":23,"page":456,"sajda":false},{"number":59,"text":{"ar":"هَٰذَا فَوۡجٞ مُّقۡتَحِمٞ مَّعَكُمۡ لَا مَرۡحَبَۢا بِهِمۡۚ إِنَّهُمۡ صَالُواْ ٱلنَّارِ"},"juz":23,"page":456,"sajda":false},{"number":60,"text":{"ar":"قَالُواْ بَلۡ أَنتُمۡ لَا مَرۡحَبَۢا بِكُمۡۖ أَنتُمۡ قَدَّمۡتُمُوهُ لَنَاۖ فَبِئۡسَ ٱلۡقَرَارُ"},"juz":23,"page":456,"sajda":false},{"number":61,"text":{"ar":"قَالُواْ رَبَّنَا مَن قَدَّمَ لَنَا هَٰذَا فَزِدۡهُ عَذَابٗا ضِعۡفٗا فِي ٱلنَّارِ"},"juz":23,"page":456,"sajda":false},{"number":62,"text":{"ar":"وَقَالُواْ مَا لَنَا لَا نَرَىٰ رِجَالٗا كُنَّا نَعُدُّهُم مِّنَ ٱلۡأَشۡرَارِ"},"juz":23,"page":457,"sajda":false},{"number":63,"text":{"ar":"أَتَّخَذۡنَٰهُمۡ سِخۡرِيًّا أَمۡ زَاغَتۡ عَنۡهُمُ ٱلۡأَبۡصَٰرُ"},"juz":23,"page":457,"sajda":false},{"number":64,"text":{"ar":"إِنَّ ذَٰلِكَ لَحَقّٞ تَخَاصُمُ أَهۡلِ ٱلنَّارِ"},"juz":23,"page":457,"sajda":false},{"number":65,"text":{"ar":"قُلۡ إِنَّمَآ أَنَا۠ مُنذِرٞۖ وَمَا مِنۡ إِلَٰهٍ إِلَّا ٱللَّهُ ٱلۡوَٰحِدُ ٱلۡقَهَّارُ"},"juz":23,"page":457,"sajda":false},{"number":66,"text":{"ar":"رَبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلۡعَزِيزُ ٱلۡغَفَّـٰرُ"},"juz":23,"page":457,"sajda":false},{"number":67,"text":{"ar":"قُلۡ هُوَ نَبَؤٌاْ عَظِيمٌ"},"juz":23,"page":457,"sajda":false},{"number":68,"text":{"ar":"أَنتُمۡ عَنۡهُ مُعۡرِضُونَ"},"juz":23,"page":457,"sajda":false},{"number":69,"text":{"ar":"مَا كَانَ لِيَ مِنۡ عِلۡمِۭ بِٱلۡمَلَإِ ٱلۡأَعۡلَىٰٓ إِذۡ يَخۡتَصِمُونَ"},"juz":23,"page":457,"sajda":false},{"number":70,"text":{"ar":"إِن يُوحَىٰٓ إِلَيَّ إِلَّآ أَنَّمَآ أَنَا۠ نَذِيرٞ مُّبِينٌ"},"juz":23,"page":457,"sajda":false},{"number":71,"text":{"ar":"إِذۡ قَالَ رَبُّكَ لِلۡمَلَـٰٓئِكَةِ إِنِّي خَٰلِقُۢ بَشَرٗا مِّن طِينٖ"},"juz":23,"page":457,"sajda":false},{"number":72,"text":{"ar":"فَإِذَا سَوَّيۡتُهُۥ وَنَفَخۡتُ فِيهِ مِن رُّوحِي فَقَعُواْ لَهُۥ سَٰجِدِينَ"},"juz":23,"page":457,"sajda":false},{"number":73,"text":{"ar":"فَسَجَدَ ٱلۡمَلَـٰٓئِكَةُ كُلُّهُمۡ أَجۡمَعُونَ"},"juz":23,"page":457,"sajda":false},{"number":74,"text":{"ar":"إِلَّآ إِبۡلِيسَ ٱسۡتَكۡبَرَ وَكَانَ مِنَ ٱلۡكَٰفِرِينَ"},"juz":23,"page":457,"sajda":false},{"number":75,"text":{"ar":"قَالَ يَـٰٓإِبۡلِيسُ مَا مَنَعَكَ أَن تَسۡجُدَ لِمَا خَلَقۡتُ بِيَدَيَّۖ أَسۡتَكۡبَرۡتَ أَمۡ كُنتَ مِنَ ٱلۡعَالِينَ"},"juz":23,"page":457,"sajda":false},{"number":76,"text":{"ar":"قَالَ أَنَا۠ خَيۡرٞ مِّنۡهُ خَلَقۡتَنِي مِن نَّارٖ وَخَلَقۡتَهُۥ مِن طِينٖ"},"juz":23,"page":457,"sajda":false},{"number":77,"text":{"ar":"قَالَ فَٱخۡرُجۡ مِنۡهَا فَإِنَّكَ رَجِيمٞ"},"juz":23,"page":457,"sajda":false},{"number":78,"text":{"ar":"وَإِنَّ عَلَيۡكَ لَعۡنَتِيٓ إِلَىٰ يَوۡمِ ٱلدِّينِ"},"juz":23,"page":457,"sajda":false},{"number":79,"text":{"ar":"قَالَ رَبِّ فَأَنظِرۡنِيٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ"},"juz":23,"page":457,"sajda":false},{"number":80,"text":{"ar":"قَالَ فَإِنَّكَ مِنَ ٱلۡمُنظَرِينَ"},"juz":23,"page":457,"sajda":false},{"number":81,"text":{"ar":"إِلَىٰ يَوۡمِ ٱلۡوَقۡتِ ٱلۡمَعۡلُومِ"},"juz":23,"page":457,"sajda":false},{"number":82,"text":{"ar":"قَالَ فَبِعِزَّتِكَ لَأُغۡوِيَنَّهُمۡ أَجۡمَعِينَ"},"juz":23,"page":457,"sajda":false},{"number":83,"text":{"ar":"إِلَّا عِبَادَكَ مِنۡهُمُ ٱلۡمُخۡلَصِينَ"},"juz":23,"page":457,"sajda":false},{"number":84,"text":{"ar":"قَالَ فَٱلۡحَقُّ وَٱلۡحَقَّ أَقُولُ"},"juz":23,"page":458,"sajda":false},{"number":85,"text":{"ar":"لَأَمۡلَأَنَّ جَهَنَّمَ مِنكَ وَمِمَّن تَبِعَكَ مِنۡهُمۡ أَجۡمَعِينَ"},"juz":23,"page":458,"sajda":false},{"number":86,"text":{"ar