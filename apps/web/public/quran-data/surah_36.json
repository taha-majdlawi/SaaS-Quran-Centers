{"number":36,"name":{"ar":"يس"},"revelation_place":{"ar":"مكية"},"verses_count":83,"verses":[{"number":1,"text":{"ar":"يسٓ"},"juz":22,"page":440,"sajda":false},{"number":2,"text":{"ar":"وَٱلۡقُرۡءَانِ ٱلۡحَكِيمِ"},"juz":22,"page":440,"sajda":false},{"number":3,"text":{"ar":"إِنَّكَ لَمِنَ ٱلۡمُرۡسَلِينَ"},"juz":22,"page":440,"sajda":false},{"number":4,"text":{"ar":"عَلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ"},"juz":22,"page":440,"sajda":false},{"number":5,"text":{"ar":"تَنزِيلَ ٱلۡعَزِيزِ ٱلرَّحِيمِ"},"juz":22,"page":440,"sajda":false},{"number":6,"text":{"ar":"لِتُنذِرَ قَوۡمٗا مَّآ أُنذِرَ ءَابَآؤُهُمۡ فَهُمۡ غَٰفِلُونَ"},"juz":22,"page":440,"sajda":false},{"number":7,"text":{"ar":"لَقَدۡ حَقَّ ٱلۡقَوۡلُ عَلَىٰٓ أَكۡثَرِهِمۡ فَهُمۡ لَا يُؤۡمِنُونَ"},"juz":22,"page":440,"sajda":false},{"number":8,"text":{"ar":"إِنَّا جَعَلۡنَا فِيٓ أَعۡنَٰقِهِمۡ أَغۡلَٰلٗا فَهِيَ إِلَى ٱلۡأَذۡقَانِ فَهُم مُّقۡمَحُونَ"},"juz":22,"page":440,"sajda":false},{"number":9,"text":{"ar":"وَجَعَلۡنَا مِنۢ بَيۡنِ أَيۡدِيهِمۡ سَدّٗا وَمِنۡ خَلۡفِهِمۡ سَدّٗا فَأَغۡشَيۡنَٰهُمۡ فَهُمۡ لَا يُبۡصِرُونَ"},"juz":22,"page":440,"sajda":false},{"number":10,"text":{"ar":"وَسَوَآءٌ عَلَيۡهِمۡ ءَأَنذَرۡتَهُمۡ أَمۡ لَمۡ تُنذِرۡهُمۡ لَا يُؤۡمِنُونَ"},"juz":22,"page":440,"sajda":false},{"number":11,"text":{"ar":"إِنَّمَا تُنذِرُ مَنِ ٱتَّبَعَ ٱلذِّكۡرَ وَخَشِيَ ٱلرَّحۡمَٰنَ بِٱلۡغَيۡبِۖ فَبَشِّرۡهُ بِمَغۡفِرَةٖ وَأَجۡرٖ كَرِيمٍ"},"juz":22,"page":440,"sajda":false},{"number":12,"text":{"ar":"إِنَّا نَحۡنُ نُحۡيِ ٱلۡمَوۡتَىٰ وَنَكۡتُبُ مَا قَدَّمُواْ وَءَاثَٰرَهُمۡۚ وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ فِيٓ إِمَامٖ مُّبِينٖ"},"juz":22,"page":440,"sajda":false},{"number":13,"text":{"ar":"وَٱضۡرِبۡ لَهُم مَّثَلًا أَصۡحَٰبَ ٱلۡقَرۡيَةِ إِذۡ جَآءَهَا ٱلۡمُرۡسَلُونَ"},"juz":22,"page":441,"sajda":false},{"number":14,"text":{"ar":"إِذۡ أَرۡسَلۡنَآ إِلَيۡهِمُ ٱثۡنَيۡنِ فَكَذَّبُوهُمَا فَعَزَّزۡنَا بِثَالِثٖ فَقَالُوٓاْ إِنَّآ إِلَيۡكُم مُّرۡسَلُونَ"},"juz":22,"page":441,"sajda":false},{"number":15,"text":{"ar":"قَالُواْ مَآ أَنتُمۡ إِلَّا بَشَرٞ مِّثۡلُنَا وَمَآ أَنزَلَ ٱلرَّحۡمَٰنُ مِن شَيۡءٍ إِنۡ أَنتُمۡ إِلَّا تَكۡذِبُونَ"},"juz":22,"page":441,"sajda":false},{"number":16,"text":{"ar":"قَالُواْ رَبُّنَا يَعۡلَمُ إِنَّآ إِلَيۡكُمۡ لَمُرۡسَلُونَ"},"juz":22,"page":441,"sajda":false},{"number":17,"text":{"ar":"وَمَا عَلَيۡنَآ إِلَّا ٱلۡبَلَٰغُ ٱلۡمُبِينُ"},"juz":22,"page":441,"sajda":false},{"number":18,"text":{"ar":"قَالُوٓاْ إِنَّا تَطَيَّرۡنَا بِكُمۡۖ لَئِن لَّمۡ تَنتَهُواْ لَنَرۡجُمَنَّكُمۡ وَلَيَمَسَّنَّكُم مِّنَّا عَذَابٌ أَلِيمٞ"},"juz":22,"page":441,"sajda":false},{"number":19,"text":{"ar":"قَالُواْ طَـٰٓئِرُكُم مَّعَكُمۡ أَئِن ذُكِّرۡتُمۚ بَلۡ أَنتُمۡ قَوۡمٞ مُّسۡرِفُونَ"},"juz":22,"page":441,"sajda":false},{"number":20,"text":{"ar":"وَجَآءَ مِنۡ أَقۡصَا ٱلۡمَدِينَةِ رَجُلٞ يَسۡعَىٰ قَالَ يَٰقَوۡمِ ٱتَّبِعُواْ ٱلۡمُرۡسَلِينَ"},"juz":22,"page":441,"sajda":false},{"number":21,"text":{"ar":"ٱتَّبِعُواْ مَن لَّا يَسۡـَٔلُكُمۡ أَجۡرٗا وَهُم مُّهۡتَدُونَ"},"juz":22,"page":441,"sajda":false},{"number":22,"text":{"ar":"وَمَالِيَ لَآ أَعۡبُدُ ٱلَّذِي فَطَرَنِي وَإِلَيۡهِ تُرۡجَعُونَ"},"juz":22,"page":441,"sajda":false},{"number":23,"text":{"ar":"ءَأَتَّخِذُ مِن دُونِهِۦٓ ءَالِهَةً إِن يُرِدۡنِ ٱلرَّحۡمَٰنُ بِضُرّٖ لَّا تُغۡنِ عَنِّي شَفَٰعَتُهُمۡ شَيۡـٔٗا وَلَا يُنقِذُونِ"},"juz":22,"page":441,"sajda":false},{"number":24,"text":{"ar":"إِنِّيٓ إِذٗا لَّفِي ضَلَٰلٖ مُّبِينٍ"},"juz":22,"page":441,"sajda":false},{"number":25,"text":{"ar":"إِنِّيٓ ءَامَنتُ بِرَبِّكُمۡ فَٱسۡمَعُونِ"},"juz":22,"page":441,"sajda":false},{"number":26,"text":{"ar":"قِيلَ ٱدۡخُلِ ٱلۡجَنَّةَۖ قَالَ يَٰلَيۡتَ قَوۡمِي يَعۡلَمُونَ"},"juz":22,"page":441,"sajda":false},{"number":27,"text":{"ar":"بِمَا غَفَرَ لِي رَبِّي وَجَعَلَنِي مِنَ ٱلۡمُكۡرَمِينَ"},"juz":22,"page":441,"sajda":false},{"number":28,"text":{"ar":"۞وَمَآ أَنزَلۡنَا عَلَىٰ قَوۡمِهِۦ مِنۢ بَعۡدِهِۦ مِن جُندٖ مِّنَ ٱلسَّمَآءِ وَمَا كُنَّا مُنزِلِينَ"},"juz":23,"page":442,"sajda":false},{"number":29,"text":{"ar":"إِن كَانَتۡ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ فَإِذَا هُمۡ خَٰمِدُونَ"},"juz":23,"page":442,"sajda":false},{"number":30,"text":{"ar":"يَٰحَسۡرَةً عَلَى ٱلۡعِبَادِۚ مَا يَأۡتِيهِم مِّن رَّسُولٍ إِلَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ"},"juz":23,"page":442,"sajda":false},{"number":31,"text":{"ar":"أَلَمۡ يَرَوۡاْ كَمۡ أَهۡلَكۡنَا قَبۡلَهُم مِّنَ ٱلۡقُرُونِ أَنَّهُمۡ إِلَيۡهِمۡ لَا يَرۡجِعُونَ"},"juz":23,"page":442,"sajda":false},{"number":32,"text":{"ar":"وَإِن كُلّٞ لَّمَّا جَمِيعٞ لَّدَيۡنَا مُحۡضَرُونَ"},"juz":23,"page":442,"sajda":false},{"number":33,"text":{"ar":"وَءَايَةٞ لَّهُمُ ٱلۡأَرۡضُ ٱلۡمَيۡتَةُ أَحۡيَيۡنَٰهَا وَأَخۡرَجۡنَا مِنۡهَا حَبّٗا فَمِنۡهُ يَأۡكُلُونَ"},"juz":23,"page":442,"sajda":false},{"number":34,"text":{"ar":"وَجَعَلۡنَا فِيهَا جَنَّـٰتٖ مِّن نَّخِيلٖ وَأَعۡنَٰبٖ وَفَجَّرۡنَا فِيهَا مِنَ ٱلۡعُيُونِ"},"juz":23,"page":442,"sajda":false},{"number":35,"text":{"ar":"لِيَأۡكُلُواْ مِن ثَمَرِهِۦ وَمَا عَمِلَتۡهُ أَيۡدِيهِمۡۚ أَفَلَا يَشۡكُرُونَ"},"juz":23,"page":442,"sajda":false},{"number":36,"text":{"ar":"سُبۡحَٰنَ ٱلَّذِي خَلَقَ ٱلۡأَزۡوَٰجَ كُلَّهَا مِمَّا تُنۢبِتُ ٱلۡأَرۡضُ وَمِنۡ أَنفُسِهِمۡ وَمِمَّا لَا يَعۡلَمُونَ"},"juz":23,"page":442,"sajda":false},{"number":37,"text":{"ar":"وَءَايَةٞ لَّهُمُ ٱلَّيۡلُ نَسۡلَخُ مِنۡهُ ٱلنَّهَارَ فَإِذَا هُم مُّظۡلِمُونَ"},"juz":23,"page":442,"sajda":false},{"number":38,"text":{"ar":"وَٱلشَّمۡسُ تَجۡرِي لِمُسۡتَقَرّٖ لَّهَاۚ ذَٰلِكَ تَقۡدِيرُ ٱلۡعَزِيزِ ٱلۡعَلِيمِ"},"juz":23,"page":442,"sajda":false},{"number":39,"text":{"ar":"وَٱلۡقَمَرَ قَدَّرۡنَٰهُ مَنَازِلَ حَتَّىٰ عَادَ كَٱلۡعُرۡجُونِ ٱلۡقَدِيمِ"},"juz":23,"page":442,"sajda":false},{"number":40,"text":{"ar":"لَا ٱلشَّمۡسُ يَنۢبَغِي لَهَآ أَن تُدۡرِكَ ٱلۡقَمَرَ وَلَا ٱلَّيۡلُ سَابِقُ ٱلنَّهَارِۚ وَكُلّٞ فِي فَلَكٖ يَسۡبَحُونَ"},"juz":23,"page":442,"sajda":false},{"number":41,"text":{"ar":"وَءَايَةٞ لَّهُمۡ أَنَّا حَمَلۡنَا ذُرِّيَّتَهُمۡ فِي ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ"},"juz":23,"page":443,"sajda":false},{"number":42,"text":{"ar":"وَخَلَقۡنَا لَهُم مِّن مِّثۡلِهِۦ مَا يَرۡكَبُونَ"},"juz":23,"page":443,"sajda":false},{"number":43,"text":{"ar":"وَإِن نَّشَأۡ نُغۡرِقۡهُمۡ فَلَا صَرِيخَ لَهُمۡ وَلَا هُمۡ يُنقَذُونَ"},"juz":23,"page":443,"sajda":false},{"number":44,"text":{"ar":"إِلَّا رَحۡمَةٗ مِّنَّا وَمَتَٰعًا إِلَىٰ حِينٖ"},"juz":23,"page":443,"sajda":false},{"number":45,"text":{"ar":"وَإِذَا قِيلَ لَهُمُ ٱتَّقُواْ مَا بَيۡنَ أَيۡدِيكُمۡ وَمَا خَلۡفَكُمۡ لَعَلَّكُمۡ تُرۡحَمُونَ"},"juz":23,"page":443,"sajda":false},{"number":46,"text":{"ar":"وَمَا تَأۡتِيهِم مِّنۡ ءَايَةٖ مِّنۡ ءَايَٰتِ رَبِّهِمۡ إِلَّا كَانُواْ عَنۡهَا مُعۡرِضِينَ"},"juz":23,"page":443,"sajda":false},{"number":47,"text":{"ar":"وَإِذَا قِيلَ لَهُمۡ أَنفِقُواْ مِمَّا رَزَقَكُمُ ٱللَّهُ قَالَ ٱلَّذِينَ كَفَرُواْ لِلَّذِينَ ءَامَنُوٓاْ أَنُطۡعِمُ مَن لَّوۡ يَشَآءُ ٱللَّهُ أَطۡعَمَهُۥٓ إِنۡ أَنتُمۡ إِلَّا فِي ضَلَٰلٖ مُّبِينٖ"},"juz":23,"page":443,"sajda":false},{"number":48,"text":{"ar":"وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ"},"juz":23,"page":443,"sajda":false},{"number":49,"text":{"ar":"مَا يَنظُرُونَ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ تَأۡخُذُهُمۡ وَهُمۡ يَخِصِّمُونَ"},"juz":23,"page":443,"sajda":false},{"number":50,"text":{"ar":"فَلَا يَسۡتَطِيعُونَ تَوۡصِيَةٗ وَلَآ إِلَىٰٓ أَهۡلِهِمۡ يَرۡجِعُونَ"},"juz":23,"page":443,"sajda":false},{"number":51,"text":{"ar":"وَنُفِخَ فِي ٱلصُّورِ فَإِذَا هُم مِّنَ ٱلۡأَجۡدَاثِ إِلَىٰ رَبِّهِمۡ يَنسِلُونَ"},"juz":23,"page":443,"sajda":false},{"number":52,"text":{"ar":"قَالُواْ يَٰوَيۡلَنَا مَنۢ بَعَثَنَا مِن مَّرۡقَدِنَاۜۗ هَٰذَا مَا وَعَدَ ٱلرَّحۡمَٰنُ وَصَدَقَ ٱلۡمُرۡسَلُونَ"},"juz":23,"page":443,"sajda":false},{"number":53,"text":{"ar":"إِن كَانَتۡ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ فَإِذَا هُمۡ جَمِيعٞ لَّدَيۡنَا مُحۡضَرُونَ"},"juz":23,"page":443,"sajda":false},{"number":54,"text":{"ar":"فَٱلۡيَوۡمَ لَا تُظۡلَمُ نَفۡسٞ شَيۡـٔٗا وَلَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ"},"juz":23,"page":443,"sajda":false},{"number":55,"text":{"ar":"إِنَّ أَصۡحَٰبَ ٱلۡجَنَّةِ ٱلۡيَوۡمَ فِي شُغُلٖ فَٰكِهُونَ"},"juz":23,"page":444,"sajda":false},{"number":56,"text":{"ar":"هُمۡ وَأَزۡوَٰجُهُمۡ فِي ظِلَٰلٍ عَلَى ٱلۡأَرَآئِكِ مُتَّكِـُٔونَ"},"juz":23,"page":444,"sajda":false},{"number":57,"text":{"ar":"لَهُمۡ فِيهَا فَٰكِهَةٞ وَلَهُم مَّا يَدَّعُونَ"},"juz":23,"page":444,"sajda":false},{"number":58,"text":{"ar":"سَلَٰمٞ قَوۡلٗا مِّن رَّبّٖ رَّحِيمٖ"},"juz":23,"page":444,"sajda":false},{"number":59,"text":{"ar":"وَٱمۡتَٰزُواْ ٱلۡيَوۡمَ أَيُّهَا ٱلۡمُجۡرِمُونَ"},"juz":23,"page":444,"sajda":false},{"number":60,"text":{"ar":"۞أَلَمۡ أَعۡهَدۡ إِلَيۡكُمۡ يَٰبَنِيٓ ءَادَمَ أَن لَّا تَعۡبُدُواْ ٱلشَّيۡطَٰنَۖ إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٞ"},"juz":23,"page":444,"sajda":false},{"number":61,"text":{"ar":"وَأَنِ ٱعۡبُدُونِيۚ هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ"},"juz":23,"page":444,"sajda":false},{"number":62,"text":{"ar":"وَلَقَدۡ أَضَلَّ مِنكُمۡ جِبِلّٗا كَثِيرًاۖ أَفَلَمۡ تَكُونُواْ تَعۡقِلُونَ"},"juz":23,"page":444,"sajda":false},{"number":63,"text":{"ar":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي كُنتُمۡ تُوعَدُونَ"},"juz":23,"page":444,"sajda":false},{"number":64,"text":{"ar":"ٱصۡلَوۡهَا ٱلۡيَوۡمَ بِمَا كُنتُمۡ تَكۡفُرُونَ"},"juz":23,"page":444,"sajda":false},{"number":65,"text":{"ar":"ٱلۡيَوۡمَ نَخۡتِمُ عَلَىٰٓ أَفۡوَٰهِهِمۡ وَتُكَلِّمُنَآ أَيۡدِيهِمۡ وَتَشۡهَدُ أَرۡجُلُهُم بِمَا كَانُواْ يَكۡسِبُونَ"},"juz":23,"page":444,"sajda":false},{"number":66,"text":{"ar":"وَلَوۡ نَشَآءُ لَطَمَسۡنَا عَلَىٰٓ أَعۡيُنِهِمۡ فَٱسۡتَبَقُواْ ٱلصِّرَٰطَ فَأَنَّىٰ يُبۡصِرُونَ"},"juz":23,"page":444,"sajda":false},{"number":67,"text":{"ar":"وَلَوۡ نَشَآءُ لَمَسَخۡنَٰهُمۡ عَلَىٰ مَكَانَتِهِمۡ فَمَا ٱسۡتَطَٰعُواْ مُضِيّٗا وَلَا يَرۡجِعُونَ"},"juz":23,"page":444,"sajda":false},{"number":68,"text":{"ar":"وَمَن نُّعَمِّرۡهُ نُنَكِّسۡهُ فِي ٱلۡخَلۡقِۚ أَفَلَا يَعۡقِلُونَ"},"juz":23,"page":444,"sajda":false},{"number":69,"text":{"ar":"وَمَا عَلَّمۡنَٰهُ ٱلشِّعۡرَ وَمَا يَنۢبَغِي لَهُۥٓۚ إِنۡ هُوَ إِلَّا ذِكۡرٞ وَقُرۡءَانٞ مُّبِينٞ"},"juz":23,"page":444,"sajda":false},{"number":70,"text":{"ar":"لِّيُنذِرَ مَن كَانَ حَيّٗا وَيَحِقَّ ٱلۡقَوۡلُ عَلَى ٱلۡكَٰفِرِينَ"},"juz":23,"page":444,"sajda":false},{"number":71,"text":{"ar":"أَوَلَمۡ يَرَوۡاْ أَنَّا خَلَقۡنَا لَهُم مِّمَّا عَمِلَتۡ أَيۡدِينَآ أَنۡعَٰمٗا فَهُمۡ لَهَا مَٰلِكُونَ"},"juz":23,"page":445,"sajda":false},{"number":72,"text":{"ar":"وَذَلَّلۡنَٰهَا لَهُمۡ فَمِنۡهَا رَكُوبُهُمۡ وَمِنۡهَا يَأۡكُلُونَ"},"juz":23,"page":445,"sajda":false},{"number":73,"text":{"ar":"وَلَهُمۡ فِيهَا مَنَٰفِعُ وَمَشَارِبُۚ أَفَلَا يَشۡكُرُونَ"},"juz":23,"page":445,"sajda":false},{"number":74,"text":{"ar":"وَٱتَّخَذُواْ مِن دُونِ ٱللَّهِ ءَالِهَةٗ لَّعَلَّهُمۡ يُنصَرُونَ"},"juz":23,"page":445,"sajda":false},{"number":75,"text":{"ar":"لَا يَسۡتَطِيعُونَ نَصۡرَهُمۡ وَهُمۡ لَهُمۡ جُندٞ مُّحۡضَرُونَ"},"juz":23,"page":445,"sajda":false},{"number":76,"text":{"ar":"فَلَا يَحۡزُنكَ قَوۡلُهُمۡۘ إِنَّا نَعۡلَمُ مَا يُسِرُّونَ وَمَا يُعۡلِنُونَ"},"juz":23,"page":445,"sajda":false},{"number":77,"text":{"ar":"أَوَلَمۡ يَرَ ٱلۡإِنسَٰنُ أَنَّا خَلَقۡنَٰهُ مِن نُّطۡفَةٖ فَإِذَا هُوَ خَصِيمٞ مُّبِينٞ"},"juz":23,"page":445,"sajda":false},{"number":78,"text":{"ar":"وَضَرَبَ لَنَا مَثَلٗا وَنَسِيَ خَلۡقَهُۥۖ قَالَ مَن يُحۡيِ ٱلۡعِظَٰمَ وَهِيَ رَمِيمٞ"},"juz":23,"page":445,"sajda":false},{"number":79,"text":{"ar":"قُلۡ يُحۡيِيهَا ٱلَّذِيٓ أَنشَأَهَآ أَوَّلَ مَرَّةٖۖ وَهُوَ بِكُلِّ خَلۡقٍ عَلِيمٌ"},"juz":23,"page":445,"sajda":false},{"number":80,"text":{"ar":"ٱلَّذِي جَعَلَ لَكُم مِّنَ ٱلشَّجَرِ ٱلۡأَخۡضَرِ نَارٗا فَإِذَآ أَنتُم مِّنۡهُ تُوقِدُونَ"},"juz":23,"page":445,"sajda":false},{"number":81,"text":{"ar":"أَوَلَيۡسَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِقَٰدِرٍ عَلَىٰٓ أَن يَخۡلُقَ مِثۡلَهُمۚ بَلَىٰ وَهُوَ ٱلۡخَلَّـٰقُ ٱلۡعَلِيمُ"},"juz":23,"page":445,"sajda":false},{"number":82,"text":{"ar":"إِنَّمَآ أَمۡرُهُۥٓ إِذَآ أَرَادَ شَيۡـًٔا أَن يَقُولَ لَهُۥ كُن فَيَكُونُ"},"juz":23,"page":445,"sajda":false},{"number":83,"text":{"ar":"فَسُبۡحَٰنَ ٱلَّذِي بِيَدِهِۦ مَلَكُوتُ كُلِّ شَيۡءٖ وَإِلَيۡهِ تُرۡجَعُونَ"},"juz":23,"page":445,"sajda":false}],"audio":[{"reciter":{"ar":"أحمد الحواشي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://serve