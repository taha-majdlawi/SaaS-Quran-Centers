ar":"فَكَيۡفَ كَانَ عَذَابِي وَنُذُرِ"},"juz":27,"page":529,"sajda":false},{"number":17,"text":{"ar":"وَلَقَدۡ يَسَّرۡنَا ٱلۡقُرۡءَانَ لِلذِّكۡرِ فَهَلۡ مِن مُّدَّكِرٖ"},"juz":27,"page":529,"sajda":false},{"number":18,"text":{"ar":"كَذَّبَتۡ عَادٞ فَكَيۡفَ كَانَ عَذَابِي وَنُذُرِ"},"juz":27,"page":529,"sajda":false},{"number":19,"text":{"ar":"إِنَّآ أَرۡسَلۡنَا عَلَيۡهِمۡ رِيحٗا صَرۡصَرٗا فِي يَوۡمِ نَحۡسٖ مُّسۡتَمِرّٖ"},"juz":27,"page":529,"sajda":false},{"number":20,"text":{"ar":"تَنزِعُ ٱلنَّاسَ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٖ مُّنقَعِرٖ"},"juz":27,"page":529,"sajda":false},{"number":21,"text":{"ar":"فَكَيۡفَ كَانَ عَذَابِي وَنُذُرِ"},"juz":27,"page":529,"sajda":false},{"number":22,"text":{"ar":"وَلَقَدۡ يَسَّرۡنَا ٱلۡقُرۡءَانَ لِلذِّكۡرِ فَهَلۡ مِن مُّدَّكِرٖ"},"juz":27,"page":529,"sajda":false},{"number":23,"text":{"ar":"كَذَّبَتۡ ثَمُودُ بِٱلنُّذُرِ"},"juz":27,"page":529,"sajda":false},{"number":24,"text":{"ar":"فَقَالُوٓاْ أَبَشَرٗا مِّنَّا وَٰحِدٗا نَّتَّبِعُهُۥٓ إِنَّآ إِذٗا لَّفِي ضَلَٰلٖ وَسُعُرٍ"},"juz":27,"page":529,"sajda":false},{"number":25,"text":{"ar":"أَءُلۡقِيَ ٱلذِّكۡرُ عَلَيۡهِ مِنۢ بَيۡنِنَا بَلۡ هُوَ كَذَّابٌ أَشِرٞ"},"juz":27,"page":529,"sajda":false},{"number":26,"text":{"ar":"سَيَعۡلَمُونَ غَدٗا مَّنِ ٱلۡكَذَّابُ ٱلۡأَشِرُ"},"juz":27,"page":529,"sajda":false},{"number":27,"text":{"ar":"إِنَّا مُرۡسِلُواْ ٱلنَّاقَةِ فِتۡنَةٗ لَّهُمۡ فَٱرۡتَقِبۡهُمۡ وَٱصۡطَبِرۡ"},"juz":27,"page":529,"sajda":false},{"number":28,"text":{"ar":"وَنَبِّئۡهُمۡ أَنَّ ٱلۡمَآءَ قِسۡمَةُۢ بَيۡنَهُمۡۖ كُلُّ شِرۡبٖ مُّحۡتَضَرٞ"},"juz":27,"page":530,"sajda":false},{"number":29,"text":{"ar":"فَنَادَوۡاْ صَاحِبَهُمۡ فَتَعَاطَىٰ فَعَقَرَ"},"juz":27,"page":530,"sajda":false},{"number":30,"text":{"ar":"فَكَيۡفَ كَانَ عَذَابِي وَنُذُرِ"},"juz":27,"page":530,"sajda":false},{"number":31,"text":{"ar":"إِنَّآ أَرۡسَلۡنَا عَلَيۡهِمۡ صَيۡحَةٗ وَٰحِدَةٗ فَكَانُواْ كَهَشِيمِ ٱلۡمُحۡتَظِرِ"},"juz":27,"page":530,"sajda":false},{"number":32,"text":{"ar":"وَلَقَدۡ يَسَّرۡنَا ٱلۡقُرۡءَانَ