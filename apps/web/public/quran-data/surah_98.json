{"number":98,"name":{"ar":"البينة"},"revelation_place":{"ar":"مدنية"},"verses_count":8,"verses":[{"number":1,"text":{"ar":"لَمۡ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ وَٱلۡمُشۡرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأۡتِيَهُمُ ٱلۡبَيِّنَةُ"},"juz":30,"page":598,"sajda":false},{"number":2,"text":{"ar":"رَسُولٞ مِّنَ ٱللَّهِ يَتۡلُواْ صُحُفٗا مُّطَهَّرَةٗ"},"juz":30,"page":598,"sajda":false},{"number":3,"text":{"ar":"فِيهَا كُتُبٞ قَيِّمَةٞ"},"juz":30,"page":598,"sajda":false},{"number":4,"text":{"ar":"وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ إِلَّا مِنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَةُ"},"juz":30,"page":598,"sajda":false},{"number":5,"text":{"ar":"وَمَآ أُمِرُوٓاْ إِلَّا لِيَعۡبُدُواْ ٱللَّهَ مُخۡلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُواْ ٱلصَّلَوٰةَ وَيُؤۡتُواْ ٱلزَّكَوٰةَۚ وَذَٰلِكَ دِينُ ٱلۡقَيِّمَةِ"},"juz":30,"page":598,"sajda":false},{"number":6,"text":{"ar":"إِنَّ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ وَٱلۡمُشۡرِكِينَ فِي نَارِ جَهَنَّمَ خَٰلِدِينَ فِيهَآۚ أُوْلَـٰٓئِكَ هُمۡ شَرُّ ٱلۡبَرِيَّةِ"},"juz":30,"page":598,"sajda":false},{"number":7,"text":{"ar":"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ أُوْلَـٰٓئِكَ هُمۡ خَيۡرُ ٱلۡبَرِيَّةِ"},"juz":30,"page":598,"sajda":false},{"number":8,"text":{"ar":"جَزَآؤُهُمۡ عِندَ رَبِّهِمۡ جَنَّـٰتُ عَدۡنٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۖ رَّضِيَ ٱللَّهُ عَنۡهُمۡ وَرَضُواْ عَنۡهُۚ ذَٰلِكَ لِمَنۡ خَشِيَ رَبَّهُۥ"},"juz":30,"page":599,"sajda":false}],"audio":[{"reciter":{"ar":"أحمد الحواشي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server11.mp3quran.net/hawashi/098.mp3"},{"reciter":{"ar":"أحمد السويلم"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server14.mp3quran.net/swlim/Rewayat-Hafs-A-n-Assem//098.mp3"},{"reciter":{"ar":"أحمد الطرابلسي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server10.mp3quran.net/trabulsi/098.mp3"},{"reciter":{"ar":"أحمد بن علي العجمي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server10.mp3quran.net/ajm/128/098.mp3"},{"reciter