{"number":72,"name":{"ar":"الجن"},"revelation_place":{"ar":"مكية"},"verses_count":28,"verses":[{"number":1,"text":{"ar":"قُلۡ أُوحِيَ إِلَيَّ أَنَّهُ ٱسۡتَمَعَ نَفَرٞ مِّنَ ٱلۡجِنِّ فَقَالُوٓاْ إِنَّا سَمِعۡنَا قُرۡءَانًا عَجَبٗا"},"juz":29,"page":572,"sajda":false},{"number":2,"text":{"ar":"يَهۡدِيٓ إِلَى ٱلرُّشۡدِ فَـَٔامَنَّا بِهِۦۖ وَلَن نُّشۡرِكَ بِرَبِّنَآ أَحَدٗا"},"juz":29,"page":572,"sajda":false},{"number":3,"text":{"ar":"وَأَنَّهُۥ تَعَٰلَىٰ جَدُّ رَبِّنَا مَا ٱتَّخَذَ صَٰحِبَةٗ وَلَا وَلَدٗا"},"juz":29,"page":572,"sajda":false},{"number":4,"text":{"ar":"وَأَنَّهُۥ كَانَ يَقُولُ سَفِيهُنَا عَلَى ٱللَّهِ شَطَطٗا"},"juz":29,"page":572,"sajda":false},{"number":5,"text":{"ar":"وَأَنَّا ظَنَنَّآ أَن لَّن تَقُولَ ٱلۡإِنسُ وَٱلۡجِنُّ عَلَى ٱللَّهِ كَذِبٗا"},"juz":29,"page":572,"sajda":false},{"number":6,"text":{"ar":"وَأَنَّهُۥ كَانَ رِجَالٞ مِّنَ ٱلۡإِنسِ يَعُوذُونَ بِرِجَالٖ مِّنَ ٱلۡجِنِّ فَزَادُوهُمۡ رَهَقٗا"},"juz":29,"page":572,"sajda":false},{"number":7,"text":{"ar":"وَأَنَّهُمۡ ظَنُّواْ كَمَا ظَنَنتُمۡ أَن لَّن يَبۡعَثَ ٱللَّهُ أَحَدٗا"},"juz":29,"page":572,"sajda":false},{"number":8,"text":{"ar":"وَأَنَّا لَمَسۡنَا ٱلسَّمَآءَ فَوَجَدۡنَٰهَا مُلِئَتۡ حَرَسٗا شَدِيدٗا وَشُهُبٗا"},"juz":29,"page":572,"sajda":false},{"number":9,"text":{"ar":"وَأَنَّا كُنَّا نَقۡعُدُ مِنۡهَا مَقَٰعِدَ لِلسَّمۡعِۖ فَمَن يَسۡتَمِعِ ٱلۡأٓنَ يَجِدۡ لَهُۥ شِهَابٗا رَّصَدٗا"},"juz":29,"page":572,"sajda":false},{"number":10,"text":{"ar":"وَأَنَّا لَا نَدۡرِيٓ أَشَرٌّ أُرِيدَ بِمَن فِي ٱلۡأَرۡضِ أَمۡ أَرَادَ بِهِمۡ رَبُّهُمۡ رَشَدٗا"},"juz":29,"page":572,"sajda":false},{"number":11,"text":{"ar":"وَأَنَّا مِنَّا ٱلصَّـٰلِحُونَ وَمِنَّا دُونَ ذَٰلِكَۖ كُنَّا طَرَآئِقَ قِدَدٗا"},"juz":29,"page":572,"sajda":false},{"number":12,"text":{"ar":"وَأَنَّا ظَنَنَّآ أَن لَّن نُّعۡجِزَ ٱللَّهَ فِي ٱلۡأَرۡضِ وَلَن نُّعۡجِزَهُۥ هَرَبٗا"},"juz":29,"page":572,"sajda":false},{"number":13,"text":{"ar":"وَأَنَّا لَمَّا سَمِعۡنَا ٱلۡهُدَىٰٓ ءَامَنَّا بِهِۦۖ فَمَن يُؤۡمِنۢ بِرَبِّهِۦ فَلَا يَخَافُ بَخۡسٗا وَلَا رَهَقٗا"},"juz":29,"page":572,"sajda":false},{"number":14,"text":{"ar":"وَأَنَّا مِنَّا ٱلۡمُسۡلِمُونَ وَمِنَّا ٱلۡقَٰسِطُونَۖ فَمَنۡ أَسۡلَمَ فَأُوْلَـٰٓئِكَ تَحَرَّوۡاْ رَشَدٗا"},"juz":29,"page":573,"sajda":false},{"number":15,"text":{"ar":"وَأَمَّا ٱلۡقَٰسِطُونَ فَكَانُواْ لِجَهَنَّمَ حَطَبٗا"},"juz":29,"page":573,"sajda":false},{"number":16,"text":{"ar":"وَأَلَّوِ ٱسۡتَقَٰمُواْ عَلَى ٱلطَّرِيقَةِ لَأَسۡقَيۡنَٰهُم مَّآءً غَدَقٗا"},"juz":29,"page":573,"sajda":false},{"number":17,"text":{"ar":"لِّنَفۡتِنَهُمۡ فِيهِۚ وَمَن يُعۡرِضۡ عَن ذِكۡرِ رَبِّهِۦ يَسۡلُكۡهُ عَذَابٗا صَعَدٗا"},"juz":29,"page":573,"sajda":false},{"number":18,"text":{"ar":"وَأَنَّ ٱلۡمَسَٰجِدَ لِلَّهِ فَلَا تَدۡعُواْ مَعَ ٱللَّهِ أَحَدٗا"},"juz":29,"page":573,"sajda":false},{"number":19,"text":{"ar":"وَأَنَّهُۥ لَمَّا قَامَ عَبۡدُ ٱللَّهِ يَدۡعُوهُ كَادُواْ يَكُونُونَ عَلَيۡهِ لِبَدٗا"},"juz":29,"page":573,"sajda":false},{"number":20,"text":{"ar":"قُلۡ إِنَّمَآ أَدۡعُواْ رَبِّي وَلَآ أُشۡرِكُ بِهِۦٓ أَحَدٗا"},"juz":29,"page":573,"sajda":false},{"number":21,"text":{"ar":"قُلۡ إِنِّي لَآ أَمۡلِكُ لَكُمۡ ضَرّٗا وَلَا رَشَدٗا"},"juz":29,"page":573,"sajda":false},{"number":22,"text":{"ar":"قُلۡ إِنِّي لَن يُجِيرَنِي مِنَ ٱللَّهِ أَحَدٞ وَلَنۡ أَجِدَ مِن دُونِهِۦ مُلۡتَحَدًا"},"juz":29,"page":573,"sajda":false},{"number":23,"text":{"ar":"إِلَّا بَلَٰغٗا مِّنَ ٱللَّهِ وَرِسَٰلَٰتِهِۦۚ وَمَن يَعۡصِ ٱللَّهَ وَرَسُولَهُۥ فَإِنَّ لَهُۥ نَارَ جَهَنَّمَ خَٰلِدِينَ فِيهَآ أَبَدًا"},"juz":29,"page":573,"sajda":false},{"number":24,"text":{"ar":"حَتَّىٰٓ إِذَا رَأَوۡاْ مَا يُوعَدُونَ فَسَيَعۡلَمُونَ مَنۡ أَضۡعَفُ نَاصِرٗا وَأَقَلُّ عَدَدٗا"},"juz":29,"page":573,"sajda":false},{"number":25,"text":{"ar":"قُلۡ إِنۡ أَدۡرِيٓ أَقَرِيبٞ مَّا تُوعَدُونَ أَمۡ يَجۡعَلُ لَهُۥ رَبِّيٓ أَمَدًا"},"juz":29,"page":573,"sajda":false},{"number":26,"text":{"ar":"عَٰلِمُ ٱلۡغَيۡبِ فَلَا يُظۡهِرُ عَلَىٰ غَيۡبِهِۦٓ أَحَدًا"},"juz":29,"page":573,"sajda":false},{"number":27,"text":{"ar":"إِلَّا مَنِ ٱرۡتَضَىٰ مِن رَّسُولٖ فَإِنَّهُۥ يَسۡلُكُ مِنۢ بَيۡنِ يَدَيۡهِ وَمِنۡ خَلۡفِهِۦ رَصَدٗا"},"juz":29,"page":573,"sajda":false},{"number":28,"text":{"ar":"لِّيَعۡلَمَ أَن قَدۡ أَبۡلَغُواْ رِسَٰلَٰتِ رَبِّهِمۡ وَأَحَاطَ بِمَا لَدَيۡهِمۡ وَأَحۡصَىٰ كُلَّ شَيۡءٍ عَدَدَۢا"},"juz":29,"page":573,"sajda":false}],"audio":[{"reciter":{"ar":"أحمد الحواشي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server11.mp3quran.net/hawashi/072.mp3"},{"reciter":{"ar":"أحمد السويلم"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server14.mp3quran.net/swlim/Rewayat-Hafs-A-n-Assem//072.mp3"},{"reciter":{"ar":"أحمد الطرابلسي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server10.mp3quran.net/trabulsi/072.mp3"},{"reciter":{"ar":"أحمد بن علي العجمي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server10.mp3quran.net/ajm/128/072.mp3"},{"reciter":{"ar":"أحمد خضر الطرابلسي"},"rewaya":{"ar":"قالون عن نافع"},"link":"https://server10.mp3quran.net/trablsi/072.mp3"},{"reciter":{"ar":"أحمد خليل شاهين"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server16.mp3quran.net/shaheen/Rewayat-Hafs-A-n-Assem/072.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"شعبة عن عاصم"},"link":"https://server16.mp3quran.net/deban/Rewayat-Sho-bah-A-n-Asim/072.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"البزي عن ابن كثير"},"link":"https://server16.mp3quran.net/deban/Rewayat-Albizi-A-n-Ibn-Katheer/072.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"قالون عن نافع"},"link":"https://server16.mp3quran.net/deban/Rewayat-Qalon-A-n-Nafi/072.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"قنبل عن ابن كثير"},"link":"https://server16.mp3quran.net/deban/Rewayat-Qunbol-A-n-Ibn-Katheer/072.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server16.mp3quran.net/deban/Rewayat-Hafs-A-n-Assem/072.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"الدوري عن أبي عمرو"},"link":"https://server16.mp3quran.net/deban/Rewayat-Aldori-A-n-Abi-Amr/072.mp3"},{"reciter":{"ar":"أحمد صابر"},"rewaya":{"ar":"حفص عن عا