{"number":50,"name":{"ar":"ق"},"revelation_place":{"ar":"مكية"},"verses_count":45,"verses":[{"number":1,"text":{"ar":"قٓۚ وَٱلۡقُرۡءَانِ ٱلۡمَجِيدِ"},"juz":26,"page":518,"sajda":false},{"number":2,"text":{"ar":"بَلۡ عَجِبُوٓاْ أَن جَآءَهُم مُّنذِرٞ مِّنۡهُمۡ فَقَالَ ٱلۡكَٰفِرُونَ هَٰذَا شَيۡءٌ عَجِيبٌ"},"juz":26,"page":518,"sajda":false},{"number":3,"text":{"ar":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗاۖ ذَٰلِكَ رَجۡعُۢ بَعِيدٞ"},"juz":26,"page":518,"sajda":false},{"number":4,"text":{"ar":"قَدۡ عَلِمۡنَا مَا تَنقُصُ ٱلۡأَرۡضُ مِنۡهُمۡۖ وَعِندَنَا كِتَٰبٌ حَفِيظُۢ"},"juz":26,"page":518,"sajda":false},{"number":5,"text":{"ar":"بَلۡ كَذَّبُواْ بِٱلۡحَقِّ لَمَّا جَآءَهُمۡ فَهُمۡ فِيٓ أَمۡرٖ مَّرِيجٍ"},"juz":26,"page":518,"sajda":false},{"number":6,"text":{"ar":"أَفَلَمۡ يَنظُرُوٓاْ إِلَى ٱلسَّمَآءِ فَوۡقَهُمۡ كَيۡفَ بَنَيۡنَٰهَا وَزَيَّنَّـٰهَا وَمَا لَهَا مِن فُرُوجٖ"},"juz":26,"page":518,"sajda":false},{"number":7,"text":{"ar":"وَٱلۡأَرۡضَ مَدَدۡنَٰهَا وَأَلۡقَيۡنَا فِيهَا رَوَٰسِيَ وَأَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجِۭ بَهِيجٖ"},"juz":26,"page":518,"sajda":false},{"number":8,"text":{"ar":"تَبۡصِرَةٗ وَذِكۡرَىٰ لِكُلِّ عَبۡدٖ مُّنِيبٖ"},"juz":26,"page":518,"sajda":false},{"number":9,"text":{"ar":"وَنَزَّلۡنَا مِنَ ٱلسَّمَآءِ مَآءٗ مُّبَٰرَكٗا فَأَنۢبَتۡنَا بِهِۦ جَنَّـٰتٖ وَحَبَّ ٱلۡحَصِيدِ"},"juz":26,"page":518,"sajda":false},{"number":10,"text":{"ar":"وَٱلنَّخۡلَ بَاسِقَٰتٖ لَّهَا طَلۡعٞ نَّضِيدٞ"},"juz":26,"page":518,"sajda":false},{"number":11,"text":{"ar":"رِّزۡقٗا لِّلۡعِبَادِۖ وَأَحۡيَيۡنَا بِهِۦ بَلۡدَةٗ مَّيۡتٗاۚ كَذَٰلِكَ ٱلۡخُرُوجُ"},"juz":26,"page":518,"sajda":false},{"number":12,"text":{"ar":"كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوحٖ وَأَصۡحَٰبُ ٱلرَّسِّ وَثَمُودُ"},"juz":26,"page":518,"sajda":false},{"number":13,"text":{"ar":"وَعَادٞ وَفِرۡعَوۡنُ وَإِخۡوَٰنُ لُوطٖ"},"juz":26,"page":518,"sajda":false},{"number":14,"text":{"ar":"وَأَصۡحَٰبُ ٱلۡأَيۡكَةِ وَقَوۡمُ تُبَّعٖۚ كُلّٞ كَذَّبَ ٱلرُّسُلَ فَحَقَّ وَعِيدِ"},"juz":26,"page":518,"sajda":false},{"number":15,"text":{"ar":"أَفَعَيِينَا بِٱلۡخَلۡقِ ٱلۡأَوَّلِۚ بَلۡ هُمۡ فِي لَبۡسٖ مِّنۡ خَلۡقٖ جَدِيدٖ"},"juz":26,"page":518,"sajda":false},{"number":16,"text":{"ar":"وَلَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ وَنَعۡلَمُ مَا تُوَسۡوِسُ بِهِۦ نَفۡسُهُۥۖ وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنۡ حَبۡلِ ٱلۡوَرِيدِ"},"juz":26,"page":519,"sajda":false},{"number":17,"text":{"ar":"إِذۡ يَتَلَقَّى ٱلۡمُتَلَقِّيَانِ عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ قَعِيدٞ"},"juz":26,"page":519,"sajda":false},{"number":18,"text":{"ar":"مَّا يَلۡفِظُ مِن قَوۡلٍ إِلَّا لَدَيۡهِ رَقِيبٌ عَتِيدٞ"},"juz":26,"page":519,"sajda":false},{"number":19,"text":{"ar":"وَجَآءَتۡ سَكۡرَةُ ٱلۡمَوۡتِ بِٱلۡحَقِّۖ ذَٰلِكَ مَا كُنتَ مِنۡهُ تَحِيدُ"},"juz":26,"page":519,"sajda":false},{"number":20,"text":{"ar":"وَنُفِخَ فِي ٱلصُّورِۚ ذَٰلِكَ يَوۡمُ ٱلۡوَعِيدِ"},"juz":26,"page":519,"sajda":false},{"number":21,"text":{"ar":"وَجَآءَتۡ كُلُّ نَفۡسٖ مَّعَهَا سَآئِقٞ وَشَهِيدٞ"},"juz":26,"page":519,"sajda":false},{"number":22,"text":{"ar":"لَّقَدۡ كُنتَ فِي غَفۡلَةٖ مِّنۡ هَٰذَا فَكَشَفۡنَا عَنكَ غِطَآءَكَ فَبَصَرُكَ ٱلۡيَوۡمَ حَدِيدٞ"},"juz":26,"page":519,"sajda":false},{"number":23,"text":{"ar":"وَقَالَ قَرِينُهُۥ هَٰذَا مَا لَدَيَّ عَتِيدٌ"},"juz":26,"page":519,"sajda":false},{"number":24,"text":{"ar":"أَلۡقِيَا فِي جَهَنَّمَ كُلَّ كَفَّارٍ عَنِيدٖ"},"juz":26,"page":519,"sajda":false},{"number":25,"text":{"ar":"مَّنَّاعٖ لِّلۡخَيۡرِ مُعۡتَدٖ مُّرِيبٍ"},"juz":26,"page":519,"sajda":false},{"number":26,"text":{"ar":"ٱلَّذِي جَعَلَ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ فَأَلۡقِيَاهُ فِي ٱلۡعَذَابِ ٱلشَّدِيدِ"},"juz":26,"page":519,"sajda":false},{"number":27,"text":{"ar":"۞قَالَ قَرِينُهُۥ رَبَّنَا مَآ أَطۡغَيۡتُهُۥ وَلَٰكِن كَانَ فِي ضَلَٰلِۭ بَعِيدٖ"},"juz":26,"page":519,"sajda":false},{"number":28,"text":{"ar":"قَالَ لَا تَخۡتَصِمُواْ لَدَيَّ وَقَدۡ قَدَّمۡتُ إِلَيۡكُم بِٱلۡوَعِيدِ"},"juz":26,"page":519,"sajda":false},{"number":29,"text":{"ar":"مَا يُبَدَّلُ ٱلۡقَوۡلُ لَدَيَّ وَمَآ أَنَا۠ بِظَلَّـٰمٖ لِّلۡعَبِيدِ"},"juz":26,"page":519,"sajda":false},{"number":30,"text":{"ar":"يَوۡمَ نَقُولُ لِجَهَنَّمَ هَلِ ٱمۡتَلَأۡتِ وَتَقُولُ هَلۡ مِن مَّزِيدٖ"},"juz":26,"page":519,"sajda":false},{"number":31,"text":{"ar":"وَأُزۡلِفَتِ ٱلۡجَنَّةُ لِلۡمُتَّقِينَ غَيۡرَ بَعِيدٍ"},"juz":26,"page":519,"sajda":false},{"number":32,"text":{"ar":"هَٰذَا مَا تُوعَدُونَ لِكُلِّ أَوَّابٍ حَفِيظٖ"},"juz":26,"page":519,"sajda":false},{"number":33,"text":{"ar":"مَّنۡ خَشِيَ ٱلرَّحۡمَٰنَ بِٱلۡغَيۡبِ وَجَآءَ بِقَلۡبٖ مُّنِيبٍ"},"juz":26,"page":519,"sajda":false},{"number":34,"text":{"ar":"ٱدۡخُلُوهَا بِسَلَٰمٖۖ ذَٰلِكَ يَوۡمُ ٱلۡخُلُودِ"},"juz":26,"page":519,"sajda":false},{"number":35,"text":{"ar":"لَهُم مَّا يَشَآءُونَ فِيهَا وَلَدَيۡنَا مَزِيدٞ"},"juz":26,"page":519,"sajda":false},{"number":36,"text":{"ar":"وَكَمۡ أَهۡلَكۡنَا قَبۡلَهُم مِّن قَرۡنٍ هُمۡ أَشَدُّ مِنۡهُم بَطۡشٗا فَنَقَّبُواْ فِي ٱلۡبِلَٰدِ هَلۡ مِن مَّحِيصٍ"},"juz":26,"page":520,"sajda":false},{"number":37,"text":{"ar":"إِنَّ فِي ذَٰلِكَ لَذِكۡرَىٰ لِمَن كَانَ لَهُۥ قَلۡبٌ أَوۡ أَلۡقَى ٱلسَّمۡعَ وَهُوَ شَهِيدٞ"},"juz":26,"page":520,"sajda":false},{"number":38,"text":{"ar":"وَلَقَدۡ خَلَقۡنَا ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا فِي سِتَّةِ أَيَّامٖ وَمَا مَسَّنَا مِن لُّغُوبٖ"},"juz":26,"page":520,"sajda":false},{"number":39,"text":{"ar":"فَٱصۡبِرۡ عَلَىٰ مَا يَقُولُونَ وَسَبِّحۡ بِحَمۡدِ رَبِّكَ قَبۡلَ طُلُوعِ ٱلشَّمۡسِ وَقَبۡلَ ٱلۡغُرُوبِ"},"juz":26,"page":520,"sajda":false},{"number":40,"text":{"ar":"وَمِنَ ٱلَّيۡلِ فَسَبِّحۡهُ وَأَدۡبَٰرَ ٱلسُّجُودِ"},"juz":26,"page":520,"sajda":false},{"number":41,"text":{"ar":"وَٱسۡتَمِعۡ يَوۡمَ يُنَادِ ٱلۡمُنَادِ مِن مَّكَانٖ قَرِيبٖ"},"juz":26,"page":520,"sajda":false},{"number":42,"text":{"ar":"يَوۡمَ يَسۡمَعُونَ ٱلصَّيۡحَةَ بِٱلۡحَقِّۚ ذَٰلِكَ يَوۡمُ ٱلۡخُرُوجِ"},"juz":26,"page":520,"sajda":false},{"number":43,"text":{"ar":"إِنَّا نَحۡنُ نُحۡيِۦ وَنُمِيتُ وَإِلَيۡنَا ٱلۡمَصِيرُ"},"juz":26,"page":520,"sajda":false},{"number":44,"text":{"ar":"يَوۡمَ تَشَقَّقُ ٱلۡأَرۡضُ عَنۡهُمۡ سِرَاعٗاۚ ذَٰلِكَ حَشۡرٌ عَلَيۡنَا يَسِيرٞ"},"juz":26,"page":520,"sajda":false},{"number":45,"text":{"ar":"نَّحۡنُ أَعۡلَمُ بِمَا يَقُولُونَۖ وَمَآ أَنتَ عَلَيۡهِم بِجَبَّارٖۖ فَذَكِّرۡ بِٱلۡقُرۡءَانِ مَن يَخَافُ وَعِيدِ"},"juz":26,"page":520,"sajda":false}],"audio":[{"reciter":{"ar":"أحمد الحواشي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server11.mp3quran.net/hawashi/050.mp3"},{"reciter":{"ar":"أحمد السويلم"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server14.mp3quran.net/swlim/Rewayat-Hafs-A-n-Assem//050.mp3"},{"reciter":{"ar":"أحمد الطرابلسي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server10.mp3quran.net/trabulsi/050.mp3"},{"reciter":{"ar":"أحمد بن علي العجمي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server10.mp3quran.net/ajm/128/050.mp3"},{"reciter":{"ar":"أحمد خضر الطرابلسي"},"rewaya":{"ar":"قالون عن نافع"},"link":"https://server10.mp3quran.net/trablsi/050.mp3"},{"reciter":{"ar":"أحمد خليل شاهين"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server16.mp3quran.net/shaheen/Rewayat-Hafs-A-n-Assem/050.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"شعبة عن عاصم"},"link":"https://server16.mp3quran.net/deban/Rewayat-Sho-bah-A-n-Asim/050.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"البزي عن ابن كثير"},"link":"https://server16.mp3quran.net/deban/Rewayat-Albizi-A-n-Ibn-Katheer/050.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"قالون عن نافع"},"link":"https://server16.mp3quran.net/deban/Rewayat-Qalon-A-n-Nafi/050.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"قنبل عن ابن كثير"},"link":"https://server16.mp3quran.net/deban/Rewayat-Qunbol-A-n-Ibn-Katheer/050.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server16.mp3quran.net/deban/Rewayat-Hafs-A-n-Assem/050.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"الدوري عن أبي عمرو"},"link":"https://server16.mp3quran.net/deban/Rewayat-Aldori-A-n-Abi-Amr/050.mp3"},{"reciter":{"ar":"أحمد صابر"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server8.mp3quran.net/saber/050.mp3"},{"reciter":{"ar":"أح