{"number":26,"name":{"ar":"الشعراء"},"revelation_place":{"ar":"مكية"},"verses_count":227,"verses":[{"number":1,"text":{"ar":"طسٓمٓ"},"juz":19,"page":367,"sajda":false},{"number":2,"text":{"ar":"تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡمُبِينِ"},"juz":19,"page":367,"sajda":false},{"number":3,"text":{"ar":"لَعَلَّكَ بَٰخِعٞ نَّفۡسَكَ أَلَّا يَكُونُواْ مُؤۡمِنِينَ"},"juz":19,"page":367,"sajda":false},{"number":4,"text":{"ar":"إِن نَّشَأۡ نُنَزِّلۡ عَلَيۡهِم مِّنَ ٱلسَّمَآءِ ءَايَةٗ فَظَلَّتۡ أَعۡنَٰقُهُمۡ لَهَا خَٰضِعِينَ"},"juz":19,"page":367,"sajda":false},{"number":5,"text":{"ar":"وَمَا يَأۡتِيهِم مِّن ذِكۡرٖ مِّنَ ٱلرَّحۡمَٰنِ مُحۡدَثٍ إِلَّا كَانُواْ عَنۡهُ مُعۡرِضِينَ"},"juz":19,"page":367,"sajda":false},{"number":6,"text":{"ar":"فَقَدۡ كَذَّبُواْ فَسَيَأۡتِيهِمۡ أَنۢبَـٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ"},"juz":19,"page":367,"sajda":false},{"number":7,"text":{"ar":"أَوَلَمۡ يَرَوۡاْ إِلَى ٱلۡأَرۡضِ كَمۡ أَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجٖ كَرِيمٍ"},"juz":19,"page":367,"sajda":false},{"number":8,"text":{"ar":"إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ"},"juz":19,"page":367,"sajda":false},{"number":9,"text":{"ar":"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ"},"juz":19,"page":367,"sajda":false},{"number":10,"text":{"ar":"وَإِذۡ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئۡتِ ٱلۡقَوۡمَ ٱلظَّـٰلِمِينَ"},"juz":19,"page":367,"sajda":false},{"number":11,"text":{"ar":"قَوۡمَ فِرۡعَوۡنَۚ أَلَا يَتَّقُونَ"},"juz":19,"page":367,"sajda":false},{"number":12,"text":{"ar":"قَالَ رَبِّ إِنِّيٓ أَخَافُ أَن يُكَذِّبُونِ"},"juz":19,"page":367,"sajda":false},{"number":13,"text":{"ar":"وَيَضِيقُ صَدۡرِي وَلَا يَنطَلِقُ لِسَانِي فَأَرۡسِلۡ إِلَىٰ هَٰرُونَ"},"juz":19,"page":367,"sajda":false},{"number":14,"text":{"ar":"وَلَهُمۡ عَلَيَّ ذَنۢبٞ فَأَخَافُ أَن يَقۡتُلُونِ"},"juz":19,"page":367,"sajda":false},{"number":15,"text":{"ar":"قَالَ كَلَّاۖ فَٱذۡهَبَا بِـَٔايَٰتِنَآۖ إِنَّا مَعَكُم مُّسۡتَمِعُونَ"},"juz":19,"page":367,"sajda":false},{"number":16,"text":{"ar":"فَأۡتِيَا فِرۡعَوۡنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلۡعَٰلَمِينَ"},"juz":19,"page":367,"sajda":false},{"number":17,"text":{"ar":"أَنۡ أَرۡسِلۡ مَعَنَا بَنِيٓ إِسۡرَـٰٓءِيلَ"},"juz":19,"page":367,"sajda":false},{"number":18,"text":{"ar":"قَالَ أَلَمۡ نُرَبِّكَ فِينَا وَلِيدٗا وَلَبِثۡتَ فِينَا مِنۡ عُمُرِكَ سِنِينَ"},"juz":19,"page":367,"sajda":false},{"number":19,"text":{"ar":"وَفَعَلۡتَ فَعۡلَتَكَ ٱلَّتِي فَعَلۡتَ وَأَنتَ مِنَ ٱلۡكَٰفِرِينَ"},"juz":19,"page":367,"sajda":false},{"number":20,"text":{"ar":"قَالَ فَعَلۡتُهَآ إِذٗا وَأَنَا۠ مِنَ ٱلضَّآلِّينَ"},"juz":19,"page":368,"sajda":false},{"number":21,"text":{"ar":"فَفَرَرۡتُ مِنكُمۡ لَمَّا خِفۡتُكُمۡ فَوَهَبَ لِي رَبِّي حُكۡمٗا وَجَعَلَنِي مِنَ ٱلۡمُرۡسَلِينَ"},"juz":19,"page":368,"sajda":false},{"number":22,"text":{"ar":"وَتِلۡكَ نِعۡمَةٞ تَمُنُّهَا عَلَيَّ أَنۡ عَبَّدتَّ بَنِيٓ إِسۡرَـٰٓءِيلَ"},"juz":19,"page":368,"sajda":false},{"number":23,"text":{"ar":"قَالَ فِرۡعَوۡنُ وَمَا رَبُّ ٱلۡعَٰلَمِينَ"},"juz":19,"page":368,"sajda":false},{"number":24,"text":{"ar":"قَالَ رَبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَآۖ إِن كُنتُم مُّوقِنِينَ"},"juz":19,"page":368,"sajda":false},{"number":25,"text":{"ar":"قَالَ لِمَنۡ حَوۡلَهُۥٓ أَلَا تَسۡتَمِعُونَ"},"juz":19,"page":368,"sajda":false},{"number":26,"text":{"ar":"قَالَ رَبُّكُمۡ وَرَبُّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ"},"juz":19,"page":368,"sajda":false},{"number":27,"text":{"ar":"قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِيٓ أُرۡسِلَ إِلَيۡكُمۡ لَمَجۡنُونٞ"},"juz":19,"page":368,"sajda":false},{"number":28,"text":{"ar":"قَالَ رَبُّ ٱلۡمَشۡرِقِ وَٱلۡمَغۡرِبِ وَمَا بَيۡنَهُمَآۖ إِن كُنتُمۡ تَعۡقِلُونَ"},"juz":19,"page":368,"sajda":false},{"number":29,"text":{"ar":"قَالَ لَئِنِ ٱتَّخَذۡتَ إِلَٰهًا غَيۡرِي لَأَجۡعَلَنَّكَ مِنَ ٱلۡمَسۡجُونِينَ"},"juz":19,"page":368,"sajda":false},{"number":30,"text":{"ar":"قَالَ أَوَلَوۡ جِئۡتُكَ بِشَيۡءٖ مُّبِينٖ"},"juz":19,"page":368,"sajda":false},{"number":31,"text":{"ar":"قَالَ فَأۡتِ بِهِۦٓ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ"},"juz":19,"page":368,"sajda":false},{"number":32,"text":{"ar":"فَأَلۡقَىٰ عَصَاهُ فَإِذَا هِيَ ثُعۡبَانٞ مُّبِينٞ"},"juz":19,"page":368,"sajda":false},{"number":33,"text":{"ar":"وَنَزَعَ يَدَهُۥ فَإِذَا هِيَ بَيۡضَآءُ لِلنَّـٰظِرِينَ"},"juz":19,"page":368,"sajda":false},{"number":34,"text":{"ar":"قَالَ لِلۡمَلَإِ حَوۡلَهُۥٓ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٞ"},"juz":19,"page":368,"sajda":false},{"number":35,"text":{"ar":"يُرِيدُ أَن يُخۡرِجَكُم مِّنۡ أَرۡضِكُم بِسِحۡرِهِۦ فَمَاذَا تَأۡمُرُونَ"},"juz":19,"page":368,"sajda":false},{"number":36,"text":{"ar":"قَالُوٓاْ أَرۡجِهۡ وَأَخَاهُ وَٱبۡعَثۡ فِي ٱلۡمَدَآئِنِ حَٰشِرِينَ"},"juz":19,"page":368,"sajda":false},{"number":37,"text":{"ar":"يَأۡتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٖ"},"juz":19,"page":368,"sajda":false},{"number":38,"text":{"ar":"فَجُمِعَ ٱلسَّحَرَةُ لِمِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ"},"juz":19,"page":368,"sajda":false},{"number":39,"text":{"ar":"وَقِيلَ لِلنَّاسِ هَلۡ أَنتُم مُّجۡتَمِعُونَ"},"juz":19,"page":368,"sajda":false},{"number":40,"text":{"ar":"لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُواْ هُمُ ٱلۡغَٰلِبِينَ"},"juz":19,"page":369,"sajda":false},{"number":41,"text":{"ar":"فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالُواْ لِفِرۡعَوۡنَ أَئِنَّ لَنَا لَأَجۡرًا إِن كُنَّا نَحۡنُ ٱلۡغَٰلِبِينَ"},"juz":19,"page":369,"sajda":false},{"number":42,"text":{"ar":"قَالَ نَعَمۡ وَإِنَّكُمۡ إِذٗا لَّمِنَ ٱلۡمُقَرَّبِينَ"},"juz":19,"page":369,"sajda":false},{"number":43,"text":{"ar":"قَالَ لَهُم مُّوسَىٰٓ أَلۡقُواْ مَآ أَنتُم مُّلۡقُونَ"},"juz":19,"page":369,"sajda":false},{"number":44,"text":{"ar":"فَأَلۡقَوۡاْ حِبَالَهُمۡ وَعِصِيَّهُمۡ وَقَالُواْ بِعِزَّةِ فِرۡعَوۡنَ إِنَّا لَنَحۡنُ ٱلۡغَٰلِبُونَ"},"juz":19,"page":369,"sajda":false},{"number":45,"text":{"ar":"فَأَلۡقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِيَ تَلۡقَفُ مَا يَأۡفِكُونَ"},"juz":19,"page":369,"sajda":false},{"number":46,"text":{"ar":"فَأُلۡقِيَ ٱلسَّحَرَةُ سَٰجِدِينَ"},"juz":19,"page":369,"sajda":false},{"number":47,"text":{"ar":"قَالُوٓاْ ءَامَنَّا بِرَبِّ ٱلۡعَٰلَمِينَ"},"juz":19,"page":369,"sajda":false},{"number":48,"text":{"ar":"رَبِّ مُوسَىٰ وَهَٰرُونَ"},"juz":19,"page":369,"sajda":false},{"number":49,"text":{"ar":"قَالَ ءَامَنتُمۡ لَهُۥ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِي عَلَّمَكُمُ ٱلسِّحۡرَ فَلَسَوۡفَ تَعۡلَمُونَۚ لَأُقَطِّعَنَّ أَيۡدِيَكُمۡ وَأَرۡجُلَكُم مِّنۡ خِلَٰفٖ وَلَأُصَلِّبَنَّكُمۡ أَجۡمَعِينَ"},"juz":19,"page":369,"sajda":false},{"number":50,"text":{"ar":"قَالُواْ لَا ضَيۡرَۖ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ"},"juz":19,"page":369,"sajda":false},{"number":51,"text":{"ar":"إِنَّا نَطۡمَعُ أَن يَغۡفِرَ لَنَا رَبُّنَا خَطَٰيَٰنَآ أَن كُنَّآ أَوَّلَ ٱلۡمُؤۡمِنِينَ"},"juz":19,"page":369,"sajda":false},{"number":52,"text":{"ar":"۞وَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنۡ أَسۡرِ بِعِبَادِيٓ إِنَّكُم مُّتَّبَعُونَ"},"juz":19,"page":369,"sajda":false},{"number":53,"text":{"ar":"فَأَرۡسَلَ فِرۡعَوۡنُ فِي ٱلۡمَدَآئِنِ حَٰشِرِينَ"},"juz":19,"page":369,"sajda":false},{"number":54,"text":{"ar":"إِنَّ هَـٰٓؤُلَآءِ لَشِرۡذِمَةٞ قَلِيلُونَ"},"juz":19,"page":369,"sajda":false},{"number":55,"text":{"ar":"وَإِنَّهُمۡ لَنَا لَغَآئِظُونَ"},"juz":19,"page":369,"sajda":false},{"number":56,"text":{"ar":"وَإِنَّا لَجَمِيعٌ حَٰذِرُونَ"},"juz":19,"page":369,"sajda":false},{"number":57,"text":{"ar":"فَأَخۡرَجۡنَٰهُم مِّن جَنَّـٰتٖ وَعُيُونٖ"},"juz":19,"page":369,"sajda":false},{"number":58,"text":{"ar":"وَكُنُوزٖ وَمَقَامٖ كَرِيمٖ"},"juz":19,"page":369,"sajda":false},{"number":59,"text":{"ar":"كَذَٰلِكَۖ وَأَوۡرَثۡنَٰهَا بَنِيٓ إِسۡرَـٰٓءِيلَ"},"juz":19,"page":369,"sajda":false},{"number":60,"text":{"ar":"فَأَتۡبَعُوهُم مُّشۡرِقِينَ"},"juz":19,"page":369,"sajda":false},{"number":61,"text":{"ar":"فَلَمَّا تَرَـٰٓءَا ٱلۡجَمۡعَانِ قَالَ أَصۡحَٰبُ مُوسَىٰٓ إِنَّا لَمُدۡرَكُونَ"},"juz":19,"page":370,"sajda":false},{"number":62,"text":{"ar":"قَالَ كَلَّآۖ إِنَّ مَعِيَ رَبِّي سَيَهۡدِينِ"},"juz":19,"page":370,"sajda":false},{"number":63,"text":{"ar":"فَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنِ ٱضۡرِب بِّعَصَاكَ ٱلۡبَحۡرَۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرۡقٖ كَٱلطَّوۡدِ ٱلۡعَظِيمِ"},"juz