{"number":76,"name":{"ar":"الإنسان"},"revelation_place":{"ar":"مدنية"},"verses_count":31,"verses":[{"number":1,"text":{"ar":"هَلۡ أَتَىٰ عَلَى ٱلۡإِنسَٰنِ حِينٞ مِّنَ ٱلدَّهۡرِ لَمۡ يَكُن شَيۡـٔٗا مَّذۡكُورًا"},"juz":29,"page":578,"sajda":false},{"number":2,"text":{"ar":"إِنَّا خَلَقۡنَا ٱلۡإِنسَٰنَ مِن نُّطۡفَةٍ أَمۡشَاجٖ نَّبۡتَلِيهِ فَجَعَلۡنَٰهُ سَمِيعَۢا بَصِيرًا"},"juz":29,"page":578,"sajda":false},{"number":3,"text":{"ar":"إِنَّا هَدَيۡنَٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرٗا وَإِمَّا كَفُورًا"},"juz":29,"page":578,"sajda":false},{"number":4,"text":{"ar":"إِنَّآ أَعۡتَدۡنَا لِلۡكَٰفِرِينَ سَلَٰسِلَاْ وَأَغۡلَٰلٗا وَسَعِيرًا"},"juz":29,"page":578,"sajda":false},{"number":5,"text":{"ar":"إِنَّ ٱلۡأَبۡرَارَ يَشۡرَبُونَ مِن كَأۡسٖ كَانَ مِزَاجُهَا كَافُورًا"},"juz":29,"page":578,"sajda":false},{"number":6,"text":{"ar":"عَيۡنٗا يَشۡرَبُ بِهَا عِبَادُ ٱللَّهِ يُفَجِّرُونَهَا تَفۡجِيرٗا"},"juz":29,"page":579,"sajda":false},{"number":7,"text":{"ar":"يُوفُونَ بِٱلنَّذۡرِ وَيَخَافُونَ يَوۡمٗا كَانَ شَرُّهُۥ مُسۡتَطِيرٗا"},"juz":29,"page":579,"sajda":false},{"number":8,"text":{"ar":"وَيُطۡعِمُونَ ٱلطَّعَامَ عَلَىٰ حُبِّهِۦ مِسۡكِينٗا وَيَتِيمٗا وَأَسِيرًا"},"juz":29,"page":579,"sajda":false},{"number":9,"text":{"ar":"إِنَّمَا نُطۡعِمُكُمۡ لِوَجۡهِ ٱللَّهِ لَا نُرِيدُ مِنكُمۡ جَزَآءٗ وَلَا شُكُورًا"},"juz":29,"page":579,"sajda":false},{"number":10,"text":{"ar":"إِنَّا نَخَافُ مِن رَّبِّنَا يَوۡمًا عَبُوسٗا قَمۡطَرِيرٗا"},"juz":29,"page":579,"sajda":false},{"number":11,"text":{"ar":"فَوَقَىٰهُمُ ٱللَّهُ شَرَّ ذَٰلِكَ ٱلۡيَوۡمِ وَلَقَّىٰهُمۡ نَضۡرَةٗ وَسُرُورٗا"},"juz":29,"page":579,"sajda":false},{"number":12,"text":{"ar":"وَجَزَىٰهُم بِمَا صَبَرُواْ جَنَّةٗ وَحَرِيرٗا"},"juz":29,"page":579,"sajda":false},{"number":13,"text":{"ar":"مُّتَّكِـِٔينَ فِيهَا عَلَى ٱلۡأَرَآئِكِۖ لَا يَرَوۡنَ فِيهَا شَمۡسٗا وَلَا زَمۡهَرِيرٗا"},"juz":29,"page":579,"sajda":false},{"number":14,"text":{"ar":"وَدَانِيَةً عَلَيۡهِمۡ ظِلَٰلُهَا وَذُلِّلَتۡ قُطُوفُهَا تَذۡلِيلٗا"},"juz":29,"page":579,"sajda":false},{"number":15,"text":{"ar":"وَيُطَافُ عَلَيۡهِم بِـَٔانِيَةٖ مِّن فِضَّةٖ وَأَكۡوَابٖ كَانَتۡ قَوَارِيرَا۠"},"juz":29,"page":579,"sajda":false},{"number":16,"text":{"ar":"قَوَارِيرَاْ مِن فِضَّةٖ قَدَّرُوهَا تَقۡدِيرٗا"},"juz":29,"page":579,"sajda":false},{"number":17,"text":{"ar":"وَيُسۡقَوۡنَ فِيهَا كَأۡسٗا كَانَ مِزَاجُهَا زَنجَبِيلًا"},"juz":29,"page":579,"sajda":false},{"number":18,"text":{"ar":"عَيۡنٗا فِيهَا تُسَمَّىٰ سَلۡسَبِيلٗا"},"juz":29,"page":579,"sajda":false},{"number":19,"text":{"ar":"۞وَيَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ إِذَا رَأَيۡتَهُمۡ حَسِبۡتَهُمۡ لُؤۡلُؤٗا مَّنثُورٗا"},"juz":29,"page":579,"sajda":false},{"number":20,"text":{"ar":"وَإِذَا رَأَيۡتَ ثَمَّ رَأَيۡتَ نَعِيمٗا وَمُلۡكٗا كَبِيرًا"},"juz":29,"page":579,"sajda":false},{"number":21,"text":{"ar":"عَٰلِيَهُمۡ ثِيَابُ سُندُسٍ خُضۡرٞ وَإِسۡتَبۡرَقٞۖ وَحُلُّوٓاْ أَسَاوِرَ مِن فِضَّةٖ وَسَقَىٰهُمۡ رَبُّهُمۡ شَرَابٗا طَهُورًا"},"juz":29,"page":579,"sajda":false},{"number":22,"text":{"ar":"إِنَّ هَٰذَا كَانَ لَكُمۡ جَزَآءٗ وَكَانَ سَعۡيُكُم مَّشۡكُورًا"},"juz":29,"page":579,"sajda":false},{"number":23,"text":{"ar":"إِنَّا نَحۡنُ نَزَّلۡنَا عَلَيۡكَ ٱلۡقُرۡءَانَ تَنزِيلٗا"},"juz":29,"page":579,"sajda":false},{"number":24,"text":{"ar":"فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تُطِعۡ مِنۡهُمۡ ءَاثِمًا أَوۡ كَفُورٗا"},"juz":29,"page":579,"sajda":false},{"number":25,"text":{"ar":"وَٱذۡكُرِ ٱسۡمَ رَبِّكَ بُكۡرَةٗ وَأَصِيلٗا"},"juz":29,"page":579,"sajda":false},{"number":26,"text":{"ar":"وَمِنَ ٱلَّيۡلِ فَٱسۡجُدۡ لَهُۥ وَسَبِّحۡهُ لَيۡلٗا طَوِيلًا"},"juz":29,"page":580,"sajda":false},{"number":27,"text":{"ar":"إِنَّ هَـٰٓؤُلَآءِ يُحِبُّونَ ٱلۡعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمۡ يَوۡمٗا ثَقِيلٗا"},"juz":29,"page":580,"sajda":false},{"number":28,"text":{"ar":"نَّحۡنُ خَلَقۡنَٰهُمۡ وَشَدَدۡنَآ أَسۡرَهُمۡۖ وَإِذَا شِئۡنَا بَدَّلۡنَآ أَمۡثَٰلَهُمۡ تَبۡدِيلًا"},"juz":29,"page":580,"sajda":false},{"number":29,"text":{"ar":"إِنَّ هَٰذِهِۦ تَذۡكِرَةٞۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلٗا"},"juz":29,"page":580,"sajda":false},{"number":30,"text":{"ar":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمٗا"},"juz":29,"page":580,"sajda":false},{"number":31,"text":{"ar":"يُدۡخِلُ مَن يَشَآءُ فِي رَحۡمَتِهِۦۚ وَٱلظَّـٰلِمِينَ أَعَدَّ لَهُمۡ عَذَابًا أَلِيمَۢا"},"juz":29,"page":580,"sajda":false}],"audio":[{"reciter":{"ar":"أحمد الحواشي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server11.mp3quran.net/hawashi/076.mp3"},{"reciter":{"ar":"أحمد السويلم"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server14.mp3quran.net/swlim/Rewayat-Hafs-A-n-Assem//076.mp3"},{"reciter":{"ar":"أحمد الطرابلسي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server10.mp3quran.net/trabulsi/076.mp3"},{"reciter":{"ar":"أحمد بن علي العجمي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server10.mp3quran.net/ajm/128/076.mp3"},{"reciter":{"ar":"أحمد خضر الطرابلسي"},"rewaya":{"ar":"قالون عن نافع"},"link":"https://server10.mp3quran.net/trablsi/076.mp3"},{"reciter":{"ar":"أحمد خليل شاهين"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server16.mp3quran.net/shaheen/Rewayat-Hafs-A-n-Assem/076.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"شعبة عن عاصم"},"link":"https://server16.mp3quran.net/deban/Rewayat-Sho-bah-A-n-Asim/076.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"البزي عن ابن كثير"},"link":"https://server16.mp3quran.net/deban/Rewayat-Albizi-A-n-Ibn-Katheer/076.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"قالون عن نافع"},"link":"https://server16.mp3quran.net/deban/Rewayat-Qalon-A-n-Nafi/076.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"قنبل عن ابن كثير"},"link":"https://server16.mp3quran.net/deban/Rewayat-Qunbol-A-n-Ibn-Katheer/076.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server16.mp3quran.net/deban/Rewayat-Hafs-A-n-Assem/076.mp3"},{"reciter":{"ar":"أحمد ديبان"},"rewaya":{"ar":"الدوري عن أبي عمرو"},"link":"https://server16.mp3quran.net/deban/Rewayat-Aldori-A-n-Abi-Amr/076.mp3"},{