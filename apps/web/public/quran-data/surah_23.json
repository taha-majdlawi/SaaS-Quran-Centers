{"number":23,"name":{"ar":"المؤمنون"},"revelation_place":{"ar":"مكية"},"verses_count":118,"verses":[{"number":1,"text":{"ar":"قَدۡ أَفۡلَحَ ٱلۡمُؤۡمِنُونَ"},"juz":18,"page":342,"sajda":false},{"number":2,"text":{"ar":"ٱلَّذِينَ هُمۡ فِي صَلَاتِهِمۡ خَٰشِعُونَ"},"juz":18,"page":342,"sajda":false},{"number":3,"text":{"ar":"وَٱلَّذِينَ هُمۡ عَنِ ٱللَّغۡوِ مُعۡرِضُونَ"},"juz":18,"page":342,"sajda":false},{"number":4,"text":{"ar":"وَٱلَّذِينَ هُمۡ لِلزَّكَوٰةِ فَٰعِلُونَ"},"juz":18,"page":342,"sajda":false},{"number":5,"text":{"ar":"وَٱلَّذِينَ هُمۡ لِفُرُوجِهِمۡ حَٰفِظُونَ"},"juz":18,"page":342,"sajda":false},{"number":6,"text":{"ar":"إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ"},"juz":18,"page":342,"sajda":false},{"number":7,"text":{"ar":"فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَـٰٓئِكَ هُمُ ٱلۡعَادُونَ"},"juz":18,"page":342,"sajda":false},{"number":8,"text":{"ar":"وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ"},"juz":18,"page":342,"sajda":false},{"number":9,"text":{"ar":"وَٱلَّذِينَ هُمۡ عَلَىٰ صَلَوَٰتِهِمۡ يُحَافِظُونَ"},"juz":18,"page":342,"sajda":false},{"number":10,"text":{"ar":"أُوْلَـٰٓئِكَ هُمُ ٱلۡوَٰرِثُونَ"},"juz":18,"page":342,"sajda":false},{"number":11,"text":{"ar":"ٱلَّذِينَ يَرِثُونَ ٱلۡفِرۡدَوۡسَ هُمۡ فِيهَا خَٰلِدُونَ"},"juz":18,"page":342,"sajda":false},{"number":12,"text":{"ar":"وَلَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ مِن سُلَٰلَةٖ مِّن طِينٖ"},"juz":18,"page":342,"sajda":false},{"number":13,"text":{"ar":"ثُمَّ جَعَلۡنَٰهُ نُطۡفَةٗ فِي قَرَارٖ مَّكِينٖ"},"juz":18,"page":342,"sajda":false},{"number":14,"text":{"ar":"ثُمَّ خَلَقۡنَا ٱلنُّطۡفَةَ عَلَقَةٗ فَخَلَقۡنَا ٱلۡعَلَقَةَ مُضۡغَةٗ فَخَلَقۡنَا ٱلۡمُضۡغَةَ عِظَٰمٗا فَكَسَوۡنَا ٱلۡعِظَٰمَ لَحۡمٗا ثُمَّ أَنشَأۡنَٰهُ خَلۡقًا ءَاخَرَۚ فَتَبَارَكَ ٱللَّهُ أَحۡسَنُ ٱلۡخَٰلِقِينَ"},"juz":18,"page":342,"sajda":false},{"number":15,"text":{"ar":"ثُمَّ إِنَّكُم بَعۡدَ ذَٰلِكَ لَمَيِّتُونَ"},"juz":18,"page":342,"sajda":false},{"number":16,"text":{"ar":"ثُمَّ إِنَّكُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ تُبۡعَثُونَ"},"juz":18,"page":342,"sajda":false},{"number":17,"text":{"ar":"وَلَقَدۡ خَلَقۡنَا فَوۡقَكُمۡ سَبۡعَ طَرَآئِقَ وَمَا كُنَّا عَنِ ٱلۡخَلۡقِ غَٰفِلِينَ"},"juz":18,"page":342,"sajda":false},{"number":18,"text":{"ar":"وَأَنزَلۡنَا مِنَ ٱلسَّمَآءِ مَآءَۢ بِقَدَرٖ فَأَسۡكَنَّـٰهُ فِي ٱلۡأَرۡضِۖ وَإِنَّا عَلَىٰ ذَهَابِۭ بِهِۦ لَقَٰدِرُونَ"},"juz":18,"page":343,"sajda":false},{"number":19,"text":{"ar":"فَأَنشَأۡنَا لَكُم بِهِۦ جَنَّـٰتٖ مِّن نَّخِيلٖ وَأَعۡنَٰبٖ لَّكُمۡ فِيهَا فَوَٰكِهُ كَثِيرَةٞ وَمِنۡهَا تَأۡكُلُونَ"},"juz":18,"page":343,"sajda":false},{"number":20,"text":{"ar":"وَشَجَرَةٗ تَخۡرُجُ مِن طُورِ سَيۡنَآءَ تَنۢبُتُ بِٱلدُّهۡنِ وَصِبۡغٖ لِّلۡأٓكِلِينَ"},"juz":18,"page":343,"sajda":false},{"number":21,"text":{"ar":"وَإِنَّ لَكُمۡ فِي ٱلۡأَنۡعَٰمِ لَعِبۡرَةٗۖ نُّسۡقِيكُم مِّمَّا فِي بُطُونِهَا وَلَكُمۡ فِيهَا مَنَٰفِعُ كَثِيرَةٞ وَمِنۡهَا تَأۡكُلُونَ"},"juz":18,"page":343,"sajda":false},{"number":22,"text":{"ar":"وَعَلَيۡهَا وَعَلَى ٱلۡفُلۡكِ تُحۡمَلُونَ"},"juz":18,"page":343,"sajda":false},{"number":23,"text":{"ar":"وَلَقَدۡ أَرۡسَلۡنَا نُوحًا إِلَىٰ قَوۡمِهِۦ فَقَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥٓۚ أَفَلَا تَتَّقُونَ"},"juz":18,"page":343,"sajda":false},{"number":24,"text":{"ar":"فَقَالَ ٱلۡمَلَؤُاْ ٱلَّذِينَ كَفَرُواْ مِن قَوۡمِهِۦ مَا هَٰذَآ إِلَّا بَشَرٞ مِّثۡلُكُمۡ يُرِيدُ أَن يَتَفَضَّلَ عَلَيۡكُمۡ وَلَوۡ شَآءَ ٱللَّهُ لَأَنزَلَ مَلَـٰٓئِكَةٗ مَّا سَمِعۡنَا بِهَٰذَا فِيٓ ءَابَآئِنَا ٱلۡأَوَّلِينَ"},"juz":18,"page":343,"sajda":false},{"number":25,"text":{"ar":"إِنۡ هُوَ إِلَّا رَجُلُۢ بِهِۦ جِنَّةٞ فَتَرَبَّصُواْ بِهِۦ حَتَّىٰ حِينٖ"},"juz":18,"page":343,"sajda":false},{"number":26,"text":{"ar":"قَالَ رَبِّ ٱنصُرۡنِي بِمَا كَذَّبُونِ"},"juz":18,"page":343,"sajda":false},{"number":27,"text":{"ar":"فَأَوۡحَيۡنَآ إِلَيۡهِ أَنِ ٱصۡنَعِ ٱلۡفُلۡكَ بِأَعۡيُنِنَا وَوَحۡيِنَا فَإِذَا جَآءَ أَمۡرُنَا وَفَارَ ٱلتَّنُّورُ فَٱسۡلُكۡ فِيهَا مِن كُلّٖ زَوۡجَيۡنِ ٱثۡنَيۡنِ وَأَهۡلَكَ إِلَّا مَن سَبَقَ عَلَيۡهِ ٱلۡقَوۡلُ مِنۡهُمۡۖ وَلَا تُخَٰطِبۡنِي فِي ٱلَّذِينَ ظَلَمُوٓاْ إِنَّهُم مُّغۡرَقُونَ"},"juz":18,"page":343,"sajda":false},{"number":28,"text":{"ar":"فَإِذَا ٱسۡتَوَيۡتَ أَنتَ وَمَن مَّعَكَ عَلَى ٱلۡفُلۡكِ فَقُلِ ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِي نَجَّىٰنَا مِنَ ٱلۡقَوۡمِ ٱلظَّـٰلِمِينَ"},"juz":18,"page":344,"sajda":false},{"number":29,"text":{"ar":"وَقُل رَّبِّ أَنزِلۡنِي مُنزَلٗا مُّبَارَكٗا وَأَنتَ خَيۡرُ ٱلۡمُنزِلِينَ"},"juz":18,"page":344,"sajda":false},{"number":30,"text":{"ar":"إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ وَإِن كُنَّا لَمُبۡتَلِينَ"},"juz":18,"page":344,"sajda":false},{"number":31,"text":{"ar":"ثُمَّ أَنشَأۡنَا مِنۢ بَعۡدِهِمۡ قَرۡنًا ءَاخَرِينَ"},"juz":18,"page":344,"sajda":false},{"number":32,"text":{"ar":"فَأَرۡسَلۡنَا فِيهِمۡ رَسُولٗا مِّنۡهُمۡ أَنِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥٓۚ أَفَلَا تَتَّقُونَ"},"juz":18,"page":344,"sajda":false},{"number":33,"text":{"ar":"وَقَالَ ٱلۡمَلَأُ مِن قَوۡمِهِ ٱلَّذِينَ كَفَرُواْ وَكَذَّبُواْ بِلِقَآءِ ٱلۡأٓخِرَةِ وَأَتۡرَفۡنَٰهُمۡ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا مَا هَٰذَآ إِلَّا بَشَرٞ مِّثۡلُكُمۡ يَأۡكُلُ مِمَّا تَأۡكُلُونَ مِنۡهُ وَيَشۡرَبُ مِمَّا تَشۡرَبُونَ"},"juz":18,"page":344,"sajda":false},{"number":34,"text":{"ar":"وَلَئِنۡ أَطَعۡتُم بَشَرٗا مِّثۡلَكُمۡ إِنَّكُمۡ إِذٗا لَّخَٰسِرُونَ"},"juz":18,"page":344,"sajda":false},{"number":35,"text":{"ar":"أَيَعِدُكُمۡ أَنَّكُمۡ إِذَا مِتُّمۡ وَكُنتُمۡ تُرَابٗا وَعِظَٰمًا أَنَّكُم مُّخۡرَجُونَ"},"juz":18,"page":344,"sajda":false},{"number":36,"text":{"ar":"۞هَيۡهَاتَ هَيۡهَاتَ لِمَا تُوعَدُونَ"},"juz":18,"page":344,"sajda":false},{"number":37,"text":{"ar":"إِنۡ هِيَ إِلَّا حَيَاتُنَا ٱلدُّنۡيَا نَمُوتُ وَنَحۡيَا وَمَا نَحۡنُ بِمَبۡعُوثِينَ"},"juz":18,"page":344,"sajda":false},{"number":38,"text":{"ar":"إِنۡ هُوَ إِلَّا رَجُلٌ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبٗا وَمَا نَحۡنُ لَهُۥ بِمُؤۡمِنِينَ"},"juz":18,"page":344,"sajda":false},{"number":39,"text":{"ar":"قَالَ رَبِّ ٱنصُرۡنِي بِمَا كَذَّبُونِ"},"juz":18,"page":344,"sajda":false},{"number":40,"text":{"ar":"قَالَ عَمَّا قَلِيلٖ لَّيُصۡبِحُنَّ نَٰدِمِينَ"},"juz":18,"page":344,"sajda":false},{"number":41,"text":{"ar":"فَأَخَذَتۡهُمُ ٱلصَّيۡحَةُ بِٱلۡحَقِّ فَجَعَلۡنَٰهُمۡ غُثَآءٗۚ فَبُعۡدٗا لِّلۡقَوۡمِ ٱلظَّـٰلِمِينَ"},"juz":18,"page":344,"sajda":false},{"number":42,"text":{"ar":"ثُمَّ أَنشَأۡنَا مِنۢ بَعۡدِهِمۡ قُرُونًا ءَاخَرِينَ"},"juz":18,"page":344,"sajda":false},{"number":43,"text":{"ar":"مَا تَسۡبِقُ مِنۡ أُمَّةٍ أَجَلَهَا وَمَا يَسۡتَـٔۡخِرُونَ"},"juz":18,"page":345,"sajda":false},{"number":44,"text":{"ar":"ثُمَّ أَرۡسَلۡنَا رُسُلَنَا تَتۡرَاۖ كُلَّ مَا جَآءَ أُمَّةٗ رَّسُولُهَا كَذَّبُوهُۖ فَأَتۡبَعۡنَا بَعۡضَهُم بَعۡضٗا وَجَعَلۡنَٰهُمۡ أَحَادِيثَۚ فَبُعۡدٗا لِّقَوۡمٖ لَّا يُؤۡمِنُونَ"},"juz":18,"page":345,"sajda":false},{"number":45,"text":{"ar":"ثُمَّ أَرۡسَلۡنَا مُوسَىٰ وَأَخَاهُ هَٰرُونَ بِـَٔايَٰتِنَا وَسُلۡطَٰنٖ مُّبِينٍ"},"juz":18,"page":345,"sajda":false},{"number":46,"text":{"ar":"إِلَىٰ فِرۡعَوۡنَ وَمَلَإِيْهِۦ فَٱسۡتَكۡبَرُواْ وَكَانُواْ قَوۡمًا عَالِينَ"},"juz":18,"page":345,"sajda":false},{"number":47,"text":{"ar":"فَقَالُوٓاْ أَنُؤۡمِنُ لِبَشَرَيۡنِ مِثۡلِنَا وَقَوۡمُهُمَا لَنَا عَٰبِدُونَ"},"juz":18,"page":345,"sajda":false},{"number":48,"text":{"ar":"فَكَذَّبُوهُمَا فَكَانُواْ مِنَ ٱلۡمُهۡلَكِينَ"},"juz":18,"page":345,"sajda":false},{"number":49,"text":{"ar":"وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ لَعَلَّهُمۡ يَهۡتَدُونَ"},"juz":18,"page":345,"sajda":false},{"number":50,"text":{"ar":"وَجَعَلۡنَا ٱبۡنَ مَرۡيَمَ وَأُمَّهُۥٓ ءَايَةٗ وَءَاوَيۡنَٰهُمَآ إِلَىٰ رَبۡوَةٖ ذَاتِ قَرَارٖ وَمَعِينٖ"},"juz":18,"page":345,"sajda":false},{"number":51,"text":{"ar":"يَـٰٓأَيُّهَا ٱلرُّسُلُ كُلُواْ مِنَ ٱلطَّيِّبَٰتِ وَٱعۡمَلُواْ صَٰلِحًاۖ إِنِّي بِمَا تَعۡمَلُونَ عَلِيمٞ"},"juz":18,"page":345,"sajda":false},{"number":52,"text":{"ar":"وَإِنَّ هَٰذِهِۦٓ أُمَّتُكُمۡ أُمَّةٗ وَٰحِدَةٗ وَأَنَا۠ رَبُّكُمۡ فَٱتَّقُونِ"},"juz":18,"page":345,"sajda":false},{"number":53,"text":{"ar":"فَتَقَطَّعُوٓاْ أَمۡرَهُم بَيۡنَهُمۡ زُبُرٗاۖ كُلُّ حِزۡبِۭ بِمَا لَدَيۡهِمۡ فَرِحُونَ"},"juz":18,"page":345,"sajda":false},{"number":54,"text":{"ar":"فَذَرۡهُمۡ فِي غَمۡرَتِهِمۡ حَتَّىٰ حِينٍ"},"juz":18,"page":345,"sajda":false},{"number":55,"text":{"ar":"أَيَحۡسَبُونَ أَنَّمَا نُمِدُّهُم بِهِۦ مِن مَّالٖ وَبَنِينَ"},"juz":18,"page":345,"sajda":false},{"number":56,"text":{"ar":"نُسَارِعُ لَهُمۡ فِي ٱلۡخَيۡرَٰتِۚ بَل لَّا يَشۡعُرُونَ"},"juz":18,"page":345,"sajda":false},{"number":57,"text":{"ar":"إِنَّ ٱلَّذِينَ هُم مِّنۡ خَشۡيَةِ رَبِّهِم مُّشۡفِقُونَ"},"juz":18,"page":345,"sajda":false},{"number":58,"text":{"ar":"وَٱلَّذِينَ هُم بِـَٔايَٰتِ رَبِّهِمۡ يُؤۡمِنُونَ"},"juz":18,"page":345,"sajda":false},{"number":59,"text":{"ar":"وَٱلَّذِينَ هُم بِرَبِّهِمۡ لَا يُشۡرِكُونَ"},"juz":18,"page":345,"sajda":false},{"number":60,"text":{"ar":"وَٱلَّذِينَ يُؤۡتُونَ مَآ ءَاتَواْ وَّقُلُوبُهُمۡ وَجِلَةٌ أَنَّهُمۡ إِلَىٰ رَبِّهِمۡ رَٰجِعُونَ"},"juz":18,"page":346,"sajda":false},{"number":61,"text":{"ar":"أُوْلَـٰٓئِكَ يُسَٰرِعُونَ فِي ٱلۡخَيۡرَٰتِ وَهُمۡ لَهَا سَٰبِقُونَ"},"juz":18,"page":346,"sajda":false},{"number":62,"text":{"ar":"وَلَا نُكَلِّفُ نَفۡسًا إِلَّا وُسۡعَهَاۚ وَلَدَيۡنَا كِتَٰبٞ يَنطِقُ بِٱلۡحَقِّ وَهُمۡ لَا يُظۡلَمُونَ"},"juz":18,"page":346,"sajda":false},{"number":63,"text":{"ar":"بَلۡ قُلُوبُهُمۡ فِي غَمۡرَةٖ مِّنۡ هَٰذَا وَلَهُمۡ أَعۡمَٰلٞ مِّن دُونِ ذَٰلِكَ هُمۡ لَهَا عَٰمِلُونَ"},"juz":18,"page":346,"sajda":false},{"number":64,"text":{"ar":"حَتَّىٰٓ إِذَآ أَخَذۡنَا مُتۡرَفِيهِم بِٱلۡعَذَابِ إِذَا هُمۡ يَجۡـَٔرُونَ"},"juz":18,"page":346,"sajda":false},{"number":65,"text":{"ar":"لَا تَجۡـَٔرُواْ ٱلۡيَوۡمَۖ إِنَّكُم مِّنَّا لَا تُنصَرُونَ"},"juz":18,"page":346,"sajda":false},{"number":66,"text":{"ar":"قَدۡ كَانَتۡ ءَايَٰتِي تُتۡلَىٰ عَلَيۡكُمۡ فَكُنتُمۡ عَلَىٰٓ أَعۡقَٰبِكُمۡ تَنكِصُونَ"},"juz":18,"page":346,"sajda":false},{"number":67,"text":{"ar":"مُسۡتَكۡبِرِينَ بِهِۦ سَٰمِرٗا تَهۡجُرُونَ"},"juz":18,"page":346,"sajda":false},{"number":68,"text":{"ar":"أَفَلَمۡ يَدَّبَّرُواْ ٱلۡقَوۡلَ أَمۡ جَآءَهُم مَّا لَمۡ يَأۡتِ ءَابَآءَهُمُ ٱلۡأَوَّلِينَ"},"juz":18,"page":346,"sajda":false},{"number":69,"text":{"ar":"أَمۡ لَمۡ يَعۡرِفُواْ رَسُولَهُمۡ فَهُمۡ لَهُۥ مُنكِرُونَ"},"juz":18,"page":346,"sajda":false},{"number":70,"text":{"ar":"أَمۡ يَقُولُونَ بِهِۦ جِنَّةُۢۚ بَلۡ جَآءَهُم بِٱلۡحَقِّ وَأَكۡثَرُهُمۡ لِلۡحَقِّ كَٰرِهُونَ"},"juz":18,"page":346,"sajda":false},{"number":71,"text":{"ar":"وَلَوِ ٱتَّبَعَ ٱلۡحَقُّ أَهۡوَآءَهُمۡ لَفَسَدَتِ ٱلسَّمَٰوَٰتُ وَٱلۡأَرۡضُ وَمَن فِيهِنَّۚ بَلۡ أَتَيۡنَٰهُم بِذِكۡرِهِمۡ فَهُمۡ عَن ذِكۡرِهِم مُّعۡرِضُونَ"},"juz":18,"page":346,"sajda":false},{"number":72,"text":{"ar":"أَمۡ تَسۡـَٔلُهُمۡ خَرۡجٗا فَخَرَاجُ رَبِّكَ خَيۡرٞۖ وَهُوَ خَيۡرُ ٱلرَّـٰزِقِينَ"},"juz":18,"page":346,"sajda":false},{"number":73,"text":{"ar":"وَإِنَّكَ لَتَدۡعُوهُمۡ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ"},"juz":18,"page":346,"sajda":false},{"number":74,"text":{"ar":"وَإِنَّ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ عَنِ ٱلصِّرَٰطِ لَنَٰكِبُونَ"},"juz":18,"page":346,"sajda":false},{"number":75,"text":{"ar":"۞وَلَوۡ رَحِمۡنَٰهُمۡ وَكَشَفۡنَا مَا بِهِم مِّن ضُرّٖ لَّلَجُّواْ فِي طُغۡيَٰنِهِمۡ يَعۡمَهُونَ"},"juz":18,"page":347,"sajda":false},{"number":76,"text":{"ar":"وَلَقَدۡ أَخَذۡنَٰهُم بِٱلۡعَذَابِ فَمَا ٱسۡتَكَانُواْ لِرَبِّهِمۡ وَمَا يَتَضَرَّعُونَ"},"juz":18,"page":347,"sajda":false},{"number":77,"text":{"ar":"حَتَّىٰٓ إِذَا فَتَحۡنَا عَلَيۡهِم بَابٗا ذَا عَذَابٖ شَدِيدٍ إِذَا هُمۡ فِيهِ مُبۡلِسُونَ"},"juz":18,"page":347,"sajda":false},{"number":78,"text":{"ar":"وَهُوَ ٱلَّذِيٓ أَنشَأَ لَكُمُ ٱلسَّمۡعَ وَٱلۡأَبۡصَٰرَ وَٱلۡأَفۡـِٔدَةَۚ قَلِيلٗا مَّا تَشۡكُرُونَ"},"juz":18,"page":347,"sajda":false},{"number":79,"text":{"ar":"وَهُوَ ٱلَّذِي ذَرَأَكُمۡ فِي ٱلۡأَرۡضِ وَإِلَيۡهِ تُحۡشَرُونَ"},"juz":18,"page":347,"sajda":false},{"number":80,"text":{"ar":"وَهُوَ ٱلَّذِي يُحۡيِۦ وَيُمِيتُ وَلَهُ ٱخۡتِلَٰفُ ٱلَّيۡلِ وَٱلنَّهَارِۚ أَفَلَا تَعۡقِلُونَ"},"juz":18,"page":347,"sajda":false},{"number":81,"text":{"ar":"بَلۡ قَالُواْ مِثۡلَ مَا قَالَ ٱلۡأَوَّلُونَ"},"juz":18,"page":347,"sajda":false},{"number":82,"text":{"ar":"قَالُوٓاْ أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ"},"juz":18,"page":347,"sajda":false},{"number":83,"text":{"ar":"لَقَدۡ وُعِدۡنَا نَحۡنُ وَءَابَآؤُنَا هَٰذَا مِن قَبۡلُ إِنۡ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلۡأَوَّلِينَ"},"juz":18,"page":347,"sajda":false},{"number":84,"text":{"ar":"قُل لِّمَنِ ٱلۡأَرۡضُ وَمَن فِيهَآ إِن كُنتُمۡ تَعۡلَمُونَ"},"juz":18,"page":347,"sajda":false},{"number":85,"text":{"ar":"سَيَقُولُونَ لِلَّهِۚ قُلۡ أَفَلَا تَذَكَّرُونَ"},"juz":18,"page":347,"sajda":false},{"number":86,"text":{"ar":"قُلۡ مَن رَّبُّ ٱلسَّمَٰوَٰتِ ٱلسَّبۡعِ وَرَبُّ ٱلۡعَرۡشِ ٱلۡعَظِيمِ"},"juz":18,"page":347,"sajda":false},{"number":87,"text":{"ar":"سَيَقُولُونَ لِلَّهِۚ قُلۡ أَفَلَا تَتَّقُونَ"},"juz":18,"page":347,"sajda":false},{"number":88,"text":{"ar":"قُلۡ مَنۢ بِيَدِهِۦ مَلَكُوتُ كُلِّ شَيۡءٖ وَهُوَ يُجِيرُ وَلَا يُجَارُ عَلَيۡهِ إِن كُنتُمۡ تَعۡلَمُونَ"},"juz":18,"page":347,"sajda":false},{"number":89,"text":{"ar":"سَيَقُولُونَ لِلَّهِۚ قُلۡ فَأَنَّىٰ تُسۡحَرُونَ"},"juz":18,"page":347,"sajda":false},{"number":90,"text":{"ar":"بَلۡ أَتَيۡنَٰهُم بِٱلۡحَقِّ وَإِنَّهُمۡ لَكَٰذِبُونَ"},"juz":18,"page":348,"sajda":false},{"number":91,"text":{"ar":"مَا ٱتَّخَذَ ٱللَّهُ مِن وَلَدٖ وَمَا كَانَ مَعَهُۥ مِنۡ إِلَٰهٍۚ إِذٗا لَّذَهَبَ كُلُّ إِلَٰهِۭ بِمَا خَلَقَ وَلَعَلَا بَعۡضُهُمۡ عَلَىٰ بَعۡضٖۚ سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ"},"juz":18,"page":348,"sajda":false},{"number":92,"text":{"ar":"عَٰلِمِ ٱلۡغَيۡبِ وَٱلشَّهَٰدَةِ فَتَعَٰلَىٰ عَمَّا يُشۡرِكُونَ"},"juz":18,"page":348,"sajda":false},{"number":93,"text":{"ar":"قُل رَّبِّ إِمَّا تُرِيَنِّي مَا يُوعَدُونَ"},"juz":18,"page":348,"sajda":false},{"number":94,"text":{"ar":"رَبِّ فَلَا تَجۡعَلۡنِي فِي ٱلۡقَوۡمِ ٱلظَّـٰلِمِينَ"},"juz":18,"page":348,"sajda":false},{"number":95,"text":{"ar":"وَإِنَّا عَلَىٰٓ أَن نُّرِيَكَ مَا نَعِدُهُمۡ لَقَٰدِرُونَ"},"juz":18,"page":348,"sajda":false},{"number":96,"text":{"ar":"ٱدۡفَعۡ بِٱلَّتِي هِيَ أَحۡسَنُ ٱلسَّيِّئَةَۚ نَحۡنُ أَعۡلَمُ بِمَا يَصِفُونَ"},"juz":18,"page":348,"sajda":false},{"number":97,"text":{"ar":"وَقُل رَّبِّ أَعُوذُ بِكَ مِنۡ هَمَزَٰتِ ٱلشَّيَٰطِينِ"},"juz":18,"page":348,"sajda":false},{"number":98,"text":{"ar":"وَأَعُوذُ بِكَ رَبِّ أَن يَحۡضُرُونِ"},"juz":18,"page":348,"sajda":false},{"number":99,"text":{"ar":"حَتَّىٰٓ إِذَا جَآءَ أَحَدَهُمُ ٱلۡمَوۡتُ قَالَ رَبِّ ٱرۡجِعُونِ"},"juz":18,"page":348,"sajda":false},{"number":100,"text":{"ar":"لَعَلِّيٓ أَعۡمَلُ صَٰلِحٗا فِيمَا تَرَكۡتُۚ كَلَّآۚ إِنَّهَا كَلِمَةٌ هُوَ قَآئِلُهَاۖ وَمِن وَرَآئِهِم بَرۡزَخٌ إِلَىٰ يَوۡمِ يُبۡعَثُونَ"},"juz":18,"page":348,"sajda":false},{"number":101,"text":{"ar":"فَإِذَا نُفِخَ فِي ٱلصُّورِ فَلَآ أَنسَابَ بَيۡنَهُمۡ يَوۡمَئِذٖ وَلَا يَتَسَآءَلُونَ"},"juz":18,"page":348,"sajda":false},{"number":102,"text":{"ar":"فَمَن ثَقُلَتۡ مَوَٰزِينُهُۥ فَأُوْلَـٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ"},"juz":18,"page":348,"sajda":false},{"number":103,"text":{"ar":"وَمَنۡ خَفَّتۡ مَوَٰزِينُهُۥ فَأُوْلَـٰٓئِكَ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُمۡ فِي جَهَنَّمَ خَٰلِدُونَ"},"juz":18,"page":348,"sajda":false},{"number":104,"text":{"ar":"تَلۡفَحُ وُجُوهَهُمُ ٱلنَّارُ وَهُمۡ فِيهَا كَٰلِحُونَ"},"juz":18,"page":348,"sajda":false},{"number":105,"text":{"ar":"أَلَمۡ تَكُنۡ ءَايَٰتِي تُتۡلَىٰ عَلَيۡكُمۡ فَكُنتُم بِهَا تُكَذِّبُونَ"},"juz":18,"page":349,"sajda":false},{"number":106,"text":{"ar":"قَالُواْ رَبَّنَا غَلَبَتۡ عَلَيۡنَا شِقۡوَتُنَا وَكُنَّا قَوۡمٗا ضَآلِّينَ"},"juz":18,"page":349,"sajda":false},{"number":107,"text":{"ar":"رَبَّنَآ أَخۡرِجۡنَا مِنۡهَا فَإِنۡ عُدۡنَا فَإِنَّا ظَٰلِمُونَ"},"juz":18,"page":349,"sajda":false},{"number":108,"text":{"ar":"قَالَ ٱخۡسَـُٔواْ فِيهَا وَلَا تُكَلِّمُونِ"},"juz":18,"page":349,"sajda":false},{"number":109,"text":{"ar":"إِنَّهُۥ كَانَ فَرِيقٞ مِّنۡ عِبَادِي يَقُولُونَ رَبَّنَآ ءَامَنَّا فَٱغۡفِرۡ لَنَا وَٱرۡحَمۡنَا وَأَنتَ خَيۡرُ ٱلرَّـٰحِمِينَ"},"juz":18,"page":349,"sajda":false},{"number":110,"text":{"ar":"فَٱتَّخَذۡتُمُوهُمۡ سِخۡرِيًّا حَتَّىٰٓ أَنسَوۡكُمۡ ذِكۡرِي وَكُنتُم مِّنۡهُمۡ تَضۡحَكُونَ"},"juz":18,"page":349,"sajda":false},{"number":111,"text":{"ar":"إِنِّي جَزَيۡتُهُمُ ٱلۡيَوۡمَ بِمَا صَبَرُوٓاْ أَنَّهُمۡ هُمُ ٱلۡفَآئِزُونَ"},"juz":18,"page":349,"sajda":false},{"number":112,"text":{"ar":"قَٰلَ كَمۡ لَبِثۡتُمۡ فِي ٱلۡأَرۡضِ عَدَدَ سِنِينَ"},"juz":18,"page":349,"sajda":false},{"number":113,"text":{"ar":"قَالُواْ لَبِثۡنَا يَوۡمًا أَوۡ بَعۡضَ يَوۡمٖ فَسۡـَٔلِ ٱلۡعَآدِّينَ"},"juz":18,"page":349,"sajda":false},{"number":114,"text":{"ar":"قَٰلَ إِن لَّبِثۡتُمۡ إِلَّا قَلِيلٗاۖ لَّوۡ أَنَّكُمۡ كُنتُمۡ تَعۡلَمُونَ"},"juz":18,"page":349,"sajda":false},{"number":115,"text":{"ar":"أَفَحَسِبۡتُمۡ أَنَّمَا خَلَقۡنَٰكُمۡ عَبَثٗا وَأَنَّكُمۡ إِلَيۡنَا لَا تُرۡجَعُونَ"},"juz":18,"page":349,"sajda":false},{"number":116,"text":{"ar":"فَتَعَٰلَى ٱللَّهُ ٱلۡمَلِكُ ٱلۡحَقُّۖ لَآ إِلَٰهَ إِلَّا هُوَ رَبُّ ٱلۡعَرۡشِ ٱلۡكَرِيمِ"},"juz":18,"page":349,"sajda":false},{"number":117,"text":{"ar":"وَمَن يَدۡعُ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ لَا بُرۡهَٰنَ لَهُۥ بِهِۦ فَإِنَّمَا حِسَابُهُۥ عِندَ رَبِّهِۦٓۚ إِنَّهُۥ لَا يُفۡلِحُ ٱلۡكَٰفِرُونَ"},"juz":18,"page":349,"sajda":false},{"number":118,"text":{"ar":"وَقُل رَّبِّ ٱغۡفِرۡ وَٱرۡحَمۡ وَأَنتَ خَيۡرُ ٱلرَّـٰحِمِينَ"},"juz":18,"page":349,"sajda":false}],"audio":[{"reciter":{"ar":"أحمد الحواشي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server11.mp3quran.net/hawashi/023.mp3"},{"reciter":{"ar":"أحمد السويلم"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server14.mp3quran.net/swlim/Rewayat-Hafs-A-n-Assem//023.mp3"},{"reciter":{"ar":"أحمد الطرابلسي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server10.mp3quran.net/trabulsi/023.mp3"},{"reciter":{"ar":"أحمد بن علي العجمي"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server10.mp3quran.net/ajm/128/023.mp3"},{"reciter":{"ar":"أحمد خضر الطرابلسي"},"rewaya":{"ar":"قالون عن نافع"},"link":"https://server10.mp3quran.net/trablsi/023.mp3"},{"reciter":{"ar":"أحمد خليل شاهين"},"rewaya":{"ar":"حفص عن عاصم"},"link":"https://server16.mp3quran.net/shaheen/Rewayat-Hafs-A-n-Assem/023.mp3"},{"reciter":{