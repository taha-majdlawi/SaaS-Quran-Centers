{"number":71,"name":{"ar":"نوح"},"revelation_place":{"ar":"مكية"},"verses_count":28,"verses":[{"number":1,"text":{"ar":"إِنَّآ أَرۡسَلۡنَا نُوحًا إِلَىٰ قَوۡمِهِۦٓ أَنۡ أَنذِرۡ قَوۡمَكَ مِن قَبۡلِ أَن يَأۡتِيَهُمۡ عَذَابٌ أَلِيمٞ"},"juz":29,"page":570,"sajda":false},{"number":2,"text":{"ar":"قَالَ يَٰقَوۡمِ إِنِّي لَكُمۡ نَذِيرٞ مُّبِينٌ"},"juz":29,"page":570,"sajda":false},{"number":3,"text":{"ar":"أَنِ ٱعۡبُدُواْ ٱللَّهَ وَٱتَّقُوهُ وَأَطِيعُونِ"},"juz":29,"page":570,"sajda":false},{"number":4,"text":{"ar":"يَغۡفِرۡ لَكُم مِّن ذُنُوبِكُمۡ وَيُؤَخِّرۡكُمۡ إِلَىٰٓ أَجَلٖ مُّسَمًّىۚ إِنَّ أَجَلَ ٱللَّهِ إِذَا جَآءَ لَا يُؤَخَّرُۚ لَوۡ كُنتُمۡ تَعۡلَمُونَ"},"juz":29,"page":570,"sajda":false},{"number":5,"text":{"ar":"قَالَ رَبِّ إِنِّي دَعَوۡتُ قَوۡمِي لَيۡلٗا وَنَهَارٗا"},"juz":29,"page":570,"sajda":false},{"number":6,"text":{"ar":"فَلَمۡ يَزِدۡهُمۡ دُعَآءِيٓ إِلَّا فِرَارٗا"},"juz":29,"page":570,"sajda":false},{"number":7,"text":{"ar":"وَإِنِّي كُلَّمَا دَعَوۡتُهُمۡ لِتَغۡفِرَ لَهُمۡ جَعَلُوٓاْ أَصَٰبِعَهُمۡ فِيٓ ءَاذَانِهِمۡ وَٱسۡتَغۡشَوۡاْ ثِيَابَهُمۡ وَأَصَرُّواْ وَٱسۡتَكۡبَرُواْ ٱسۡتِكۡبَارٗا"},"juz":29,"page":570,"sajda":false},{"number":8,"text":{"ar":"ثُمَّ إِنِّي دَعَوۡتُهُمۡ جِهَارٗا"},"juz":29,"page":570,"sajda":false},{"number":9,"text":{"ar":"ثُمَّ إِنِّيٓ أَعۡلَنتُ لَهُمۡ وَأَسۡرَرۡتُ لَهُمۡ إِسۡرَارٗا"},"juz":29,"page":570,"sajda":false},{"number":10,"text":{"ar":"فَقُلۡتُ ٱسۡتَغۡفِرُواْ رَبَّكُمۡ إِنَّهُۥ كَانَ غَفَّارٗا"},"juz":29,"page":570,"sajda":false},{"number":11,"text":{"ar":"يُرۡسِلِ ٱلسَّمَآءَ عَلَيۡكُم مِّدۡرَارٗا"},"juz":29,"page":571,"sajda":false},{"number":12,"text":{"ar":"وَيُمۡدِدۡكُم بِأَمۡوَٰلٖ وَبَنِينَ وَيَجۡعَل لَّكُمۡ جَنَّـٰتٖ وَيَجۡعَل لَّكُمۡ أَنۡهَٰرٗا"},"juz":29,"page":571,"sajda":false},{"number":13,"text":{"ar":"مَّا لَكُمۡ لَا تَرۡجُونَ لِلَّهِ وَقَارٗا"},"juz":29,"page":571,"sajda":false},{"number":14,"text":{"ar":"وَقَدۡ خَلَقَكُمۡ أَطۡوَارًا"},"juz":29,"page":571,"sajda":false},{"number":15,"text":{"ar":"أَلَمۡ تَ