{"number":15,"name":{"ar":"الحجر"},"revelation_place":{"ar":"مكية"},"verses_count":99,"verses":[{"number":1,"text":{"ar":"الٓرۚ تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ وَقُرۡءَانٖ مُّبِينٖ"},"juz":14,"page":262,"sajda":false},{"number":2,"text":{"ar":"رُّبَمَا يَوَدُّ ٱلَّذِينَ كَفَرُواْ لَوۡ كَانُواْ مُسۡلِمِينَ"},"juz":14,"page":262,"sajda":false},{"number":3,"text":{"ar":"ذَرۡهُمۡ يَأۡكُلُواْ وَيَتَمَتَّعُواْ وَيُلۡهِهِمُ ٱلۡأَمَلُۖ فَسَوۡفَ يَعۡلَمُونَ"},"juz":14,"page":262,"sajda":false},{"number":4,"text":{"ar":"وَمَآ أَهۡلَكۡنَا مِن قَرۡيَةٍ إِلَّا وَلَهَا كِتَابٞ مَّعۡلُومٞ"},"juz":14,"page":262,"sajda":false},{"number":5,"text":{"ar":"مَّا تَسۡبِقُ مِنۡ أُمَّةٍ أَجَلَهَا وَمَا يَسۡتَـٔۡخِرُونَ"},"juz":14,"page":262,"sajda":false},{"number":6,"text":{"ar":"وَقَالُواْ يَـٰٓأَيُّهَا ٱلَّذِي نُزِّلَ عَلَيۡهِ ٱلذِّكۡرُ إِنَّكَ لَمَجۡنُونٞ"},"juz":14,"page":262,"sajda":false},{"number":7,"text":{"ar":"لَّوۡمَا تَأۡتِينَا بِٱلۡمَلَـٰٓئِكَةِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ"},"juz":14,"page":262,"sajda":false},{"number":8,"text":{"ar":"مَا نُنَزِّلُ ٱلۡمَلَـٰٓئِكَةَ إِلَّا بِٱلۡحَقِّ وَمَا كَانُوٓاْ إِذٗا مُّنظَرِينَ"},"juz":14,"page":262,"sajda":false},{"number":9,"text":{"ar":"إِنَّا نَحۡنُ نَزَّلۡنَا ٱلذِّكۡرَ وَإِنَّا لَهُۥ لَحَٰفِظُونَ"},"juz":14,"page":262,"sajda":false},{"number":10,"text":{"ar":"وَلَقَدۡ أَرۡسَلۡنَا مِن قَبۡلِكَ فِي شِيَعِ ٱلۡأَوَّلِينَ"},"juz":14,"page":262,"sajda":false},{"number":11,"text":{"ar":"وَمَا يَأۡتِيهِم مِّن رَّسُولٍ إِلَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ"},"juz":14,"page":262,"sajda":false},{"number":12,"text":{"ar":"كَذَٰلِكَ نَسۡلُكُهُۥ فِي قُلُوبِ ٱلۡمُجۡرِمِينَ"},"juz":14,"page":262,"sajda":false},{"number":13,"text":{"ar":"لَا يُؤۡمِنُونَ بِهِۦ وَقَدۡ خَلَتۡ سُنَّةُ ٱلۡأَوَّلِينَ"},"juz":14,"page":262,"sajda":false},{"number":14,"text":{"ar":"وَلَوۡ فَتَحۡنَا عَلَيۡهِم بَابٗا مِّنَ ٱلسَّمَآءِ فَظَلُّواْ فِيهِ يَعۡرُجُونَ"},"juz":14,"page":262,"sajda":false},{"number":15,"text":{"ar":"لَقَالُوٓاْ إِنَّمَا سُكِّرَتۡ أَبۡصَٰرُنَا بَلۡ نَحۡنُ قَوۡمٞ مَّسۡحُورُونَ"},"juz":14,"page":262,"sajda":false},{"number":16,"text":{"ar":"وَلَقَدۡ جَعَلۡنَا فِي ٱلسَّمَآءِ بُرُوجٗا وَزَيَّنَّـٰهَا لِلنَّـٰظِرِينَ"},"juz":14,"page":263,"sajda":false},{"number":17,"text":{"ar":"وَحَفِظۡنَٰهَا مِن كُلِّ شَيۡطَٰنٖ رَّجِيمٍ"},"juz":14,"page":263,"sajda":false},{"number":18,"text":{"ar":"إِلَّا مَنِ ٱسۡتَرَقَ ٱلسَّمۡعَ فَأَتۡبَعَهُۥ شِهَابٞ مُّبِينٞ"},"juz":14,"page":263,"sajda":false},{"number":19,"text":{"ar":"وَٱلۡأَرۡضَ مَدَدۡنَٰهَا وَأَلۡقَيۡنَا فِيهَا رَوَٰسِيَ وَأَنۢبَتۡنَا فِيهَا مِن كُلِّ شَيۡءٖ مَّوۡزُونٖ"},"juz":14,"page":263,"sajda":false},{"number":20,"text":{"ar":"وَجَعَلۡنَا لَكُمۡ فِيهَا مَعَٰيِشَ وَمَن لَّسۡتُمۡ لَهُۥ بِرَٰزِقِينَ"},"juz":14,"page":263,"sajda":false},{"number":21,"text":{"ar":"وَإِن مِّن شَيۡءٍ إِلَّا عِندَنَا خَزَآئِنُهُۥ وَمَا نُنَزِّلُهُۥٓ إِلَّا بِقَدَرٖ مَّعۡلُومٖ"},"juz":14,"page":263,"sajda":false},{"number":22,"text":{"ar":"وَأَرۡسَلۡنَا ٱلرِّيَٰحَ لَوَٰقِحَ فَأَنزَلۡنَا مِنَ ٱلسَّمَآءِ مَآءٗ فَأَسۡقَيۡنَٰكُمُوهُ وَمَآ أَنتُمۡ لَهُۥ بِخَٰزِنِينَ"},"juz":14,"page":263,"sajda":false},{"number":23,"text":{"ar":"وَإِنَّا لَنَحۡنُ نُحۡيِۦ وَنُمِيتُ وَنَحۡنُ ٱلۡوَٰرِثُونَ"},"juz":14,"page":263,"sajda":false},{"number":24,"text":{"ar":"وَلَقَدۡ عَلِمۡنَا ٱلۡمُسۡتَقۡدِمِينَ مِنكُمۡ وَلَقَدۡ عَلِمۡنَا ٱلۡمُسۡتَـٔۡخِرِينَ"},"juz":14,"page":263,"sajda":false},{"number":25,"text":{"ar":"وَإِنَّ رَبَّكَ هُوَ يَحۡشُرُهُمۡۚ إِنَّهُۥ حَكِيمٌ عَلِيمٞ"},"juz":14,"page":263,"sajda":false},{"number":26,"text":{"ar":"وَلَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ مِّنۡ حَمَإٖ مَّسۡنُونٖ"},"juz":14,"page":263,"sajda":false},{"number":27,"text":{"ar":"وَٱلۡجَآنَّ خَلَقۡنَٰهُ مِن قَبۡلُ مِن نَّارِ ٱلسَّمُومِ"},"juz":14,"page":263,"sajda":false},{"number":28,"text":{"ar":"وَإِذۡ قَالَ رَبُّكَ لِلۡمَلَـٰٓئِكَةِ إِنِّي خَٰلِقُۢ بَشَرٗا مِّن صَلۡصَٰلٖ مِّنۡ حَمَإٖ مَّسۡنُونٖ"},"juz":14,"page":263,"sajda":false},{"number":29,"text":{"ar":"فَإِذَا سَوَّيۡتُهُۥ وَنَفَخۡتُ فِيهِ مِن رُّوحِي فَقَعُواْ لَهُۥ سَٰجِدِينَ"},"juz":14,"page":263,"sajda":false},{"number":30,"text":{"ar":"فَسَجَدَ ٱلۡمَلَـٰٓئِكَةُ كُلُّهُمۡ أَجۡمَعُونَ"},"juz":14,"page":263,"sajda":false},{"number":31,"text":{"ar":"إِلَّآ إِبۡلِيسَ أَبَىٰٓ أَن يَكُونَ مَعَ ٱلسَّـٰجِدِينَ"},"juz":14,"page":263,"sajda":false},{"number":32,"text":{"ar":"قَالَ يَـٰٓإِبۡلِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ ٱلسَّـٰجِدِينَ"},"juz":14,"page":264,"sajda":false},{"number":33,"text":{"ar":"قَالَ لَمۡ أَكُن لِّأَسۡجُدَ لِبَشَرٍ خَلَقۡتَهُۥ مِن صَلۡصَٰلٖ مِّنۡ حَمَإٖ مَّسۡنُونٖ"},"juz":14,"page":264,"sajda":false},{"number":34,"text":{"ar":"قَالَ فَٱخۡرُجۡ مِنۡهَا فَإِنَّكَ رَجِيمٞ"},"juz":14,"page":264,"sajda":false},{"number":35,"text":{"ar":"وَإِنَّ عَلَيۡكَ ٱللَّعۡنَةَ إِلَىٰ يَوۡمِ ٱلدِّينِ"},"juz":14,"page":264,"sajda":false},{"number":36,"text":{"ar":"قَالَ رَبِّ فَأَنظِرۡنِيٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ"},"juz":14,"page":264,"sajda":false},{"number":37,"text":{"ar":"قَالَ فَإِنَّكَ مِنَ ٱلۡمُنظَرِينَ"},"juz":14,"page":264,"sajda":false},{"number":38,"text":{"ar":"إِلَىٰ يَوۡمِ ٱلۡوَقۡتِ ٱلۡمَعۡلُومِ"},"juz":14,"page":264,"sajda":false},{"number":39,"text":{"ar":"قَالَ رَبِّ بِمَآ أَغۡوَيۡتَنِي لَأُزَيِّنَنَّ لَهُمۡ فِي ٱلۡأَرۡضِ وَلَأُغۡوِيَنَّهُمۡ أَجۡمَعِينَ"},"juz":14,"page":264,"sajda":false},{"number":40,"text":{"ar":"إِلَّا عِبَادَكَ مِنۡهُمُ ٱلۡمُخۡلَصِينَ"},"juz":14,"page":264,"sajda":false},{"number":41,"text":{"ar":"قَالَ هَٰذَا صِرَٰطٌ عَلَيَّ مُسۡتَقِيمٌ"},"juz":14,"page":264,"sajda":false},{"number":42,"text":{"ar":"إِنَّ عِبَادِي لَيۡسَ لَكَ عَلَيۡهِمۡ سُلۡطَٰنٌ إِلَّا مَنِ ٱتَّبَعَكَ مِنَ ٱلۡغَاوِينَ"},"juz":14,"page":264,"sajda":false},{"number":43,"text":{"ar":"وَإِنَّ جَهَنَّمَ لَمَوۡعِدُهُمۡ أَجۡمَعِينَ"},"juz":14,"page":264,"sajda":false},{"number":44,"text":{"ar":"لَهَا سَبۡعَةُ أَبۡوَٰبٖ لِّكُلِّ بَابٖ مِّنۡهُمۡ جُزۡءٞ مَّقۡسُومٌ"},"juz":14,"page":264,"sajda":false},{"number":45,"text":{"ar":"إِنَّ ٱلۡمُتَّقِينَ فِي جَنَّـٰتٖ وَعُيُونٍ"},"juz":14,"page":264,"sajda":false},{"number":46,"text":{"ar":"ٱدۡخُلُوهَا بِسَلَٰمٍ ءَامِنِينَ"},"juz":14,"page":264,"sajda":false},{"number":47,"text":{"ar":"وَنَزَعۡنَا مَا فِي صُدُورِهِم مِّنۡ غِلٍّ إِخۡوَٰنًا عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ"},"juz":14,"page":264,"sajda":false},{"number":48,"text":{"ar":"لَا يَمَسُّهُمۡ فِيهَا نَصَبٞ وَمَا هُم مِّنۡهَا بِمُخۡرَجِينَ"},"juz":14,"page":264,"sajda":false},{"number":49,"text":{"ar":"۞نَبِّئۡ عِبَادِيٓ أَنِّيٓ أَنَا ٱلۡغَفُورُ ٱلرَّحِيمُ"},"juz":14,"page":264,"sajda":false},{"number":50,"text":{"ar":"وَأَنَّ عَذَابِي هُوَ ٱلۡعَذَابُ ٱلۡأَلِيمُ"},"juz":14,"page":264,"sajda":false},{"number":51,"text":{"ar":"وَنَبِّئۡهُمۡ عَن ضَيۡفِ إِبۡرَٰهِيمَ"},"juz":14,"page":264,"sajda":false},{"number":52,"text":{"ar":"إِذۡ دَخَلُواْ عَلَيۡهِ فَقَالُواْ سَلَٰمٗا قَالَ إِنَّا مِنكُمۡ وَجِلُونَ"},"juz":14,"page":265,"sajda":false},{"number":53,"text":{"ar":"قَالُواْ لَا تَوۡجَلۡ إِنَّا نُبَشِّرُكَ بِغُلَٰمٍ عَلِيمٖ"},"juz":14,"page":265,"sajda":false},{"number":54,"text":{"ar":"قَالَ أَبَشَّرۡتُمُونِي عَلَىٰٓ أَن مَّسَّنِيَ ٱلۡكِبَرُ فَبِمَ تُبَشِّرُونَ"},"juz":14,"page":265,"sajda":false},{"number":55,"text":{"ar":"قَالُواْ بَشَّرۡنَٰكَ بِٱلۡحَقِّ فَلَا تَكُن مِّنَ ٱلۡقَٰنِطِينَ"},"juz":14,"page":265,"sajda":false},{"number":56,"text":{"ar":"قَالَ وَمَن يَقۡنَطُ مِن رَّحۡمَةِ رَبِّهِۦٓ إِلَّا ٱلضَّآلُّونَ"},"juz":14,"page":265,"sajda":false},{"number":57,"text":{"ar":"قَالَ فَمَا خَطۡبُكُمۡ أَيُّهَا ٱلۡمُرۡسَلُونَ"},"juz":14,"page":265,"sajda":false},{"number":58,"text":{"ar":"قَالُوٓاْ إِنَّآ أُرۡسِلۡنَآ إِلَىٰ قَوۡمٖ مُّجۡرِمِينَ"},"juz":14,"page":265,"sajda":false},{"number":59,"text":{"ar":"إِلَّآ ءَالَ لُوطٍ إِنَّا لَمُنَجُّوهُمۡ أَجۡمَعِينَ"},"juz":14,"page":265,"sajda":false},{"number":60,"text":{"ar":"إِلَّا ٱمۡرَأَتَهُۥ قَدَّرۡنَآ إِنَّهَا لَمِنَ ٱلۡغَٰبِرِينَ"},"juz":14,"page":265,"sajda":false},{"number":61,"text":{"ar":"فَلَمَّا جَآءَ ءَالَ لُوطٍ ٱلۡمُرۡسَلُونَ"},"juz":14,"page":265,"sajda":false},{"number":62,"text":{"ar":"قَالَ إِنَّكُمۡ قَوۡمٞ مُّنكَرُونَ"},"juz":14,"page":265,"sajda":false},{"number":63,"text":{"ar":"قَالُواْ بَلۡ جِئۡنَٰكَ بِمَا كَانُواْ فِيهِ يَمۡتَرُونَ"},"juz":14,"page":265,"sajda":false},{"number":64,"text":{"ar":"وَأَتَيۡنَٰكَ بِٱلۡحَقِّ وَإِنَّا لَصَٰدِقُونَ"},"juz":14,"page":265,"sajda":false},{"number":65,"text":{"ar":"فَأَسۡرِ بِأَهۡلِكَ بِقِطۡعٖ مِّنَ ٱلَّيۡلِ وَٱتَّبِعۡ أَدۡبَٰرَهُمۡ وَلَا يَلۡتَفِتۡ مِنكُمۡ أَحَدٞ وَٱمۡضُواْ حَيۡثُ تُؤۡمَرُونَ"},"juz":14,"page":265,"sajda":false},{"number":66,"text":{"ar":"وَقَضَيۡنَآ إِلَيۡهِ ذَٰلِكَ ٱلۡأَمۡرَ أَنَّ دَابِرَ هَـٰٓؤُلَآءِ مَقۡطُوعٞ مُّصۡبِحِينَ"},"juz":14,"page":265,"sajda":false},{"number":67,"text":{"ar":"وَجَآءَ أَهۡلُ ٱلۡمَدِينَةِ يَسۡتَبۡشِرُونَ"},"juz":14,"page":265,"sajda":false},{"number":68,"text":{"ar":"قَالَ إِنَّ هَـٰٓؤُلَآءِ ضَيۡفِي فَلَا تَفۡضَحُونِ"},"juz":14,"page":265,"sajda":false},{"number":69,"text":{"ar":"وَٱتَّقُواْ ٱللَّهَ وَلَا تُخۡزُونِ"},"juz":14,"page":265,"sajda":false},{"number":70,"text":{"ar":"قَالُوٓاْ أَوَلَمۡ نَنۡهَكَ عَنِ ٱلۡعَٰلَمِينَ"},"juz":14,"page":265,"sajda":false},{"number":71,"text":{"ar":"قَالَ هَـٰٓؤُلَآءِ بَنَاتِيٓ إِن كُنتُمۡ فَٰعِلِينَ"},"juz":14,"page":266,"sajda":false},{"number":72,"text":{"ar":"لَعَمۡرُكَ إِنَّهُمۡ لَفِي سَكۡرَتِهِمۡ يَعۡمَهُونَ"},"juz":14,"page":266,"sajda":false},{"number":73,"text":{"ar":"فَأَخَذَتۡهُمُ ٱلصَّيۡحَةُ مُشۡرِقِينَ"},"juz":14,"page":266,"sajda":false},{"number":74,"text":{"ar":"فَجَعَلۡنَا عَٰلِيَهَا سَافِلَهَا وَأَمۡطَرۡنَا عَلَيۡهِمۡ حِجَارَةٗ مِّن سِجِّيلٍ"},"juz":14,"page":266,"sajda":false},{"number":75,"text":{"ar":"إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّلۡمُتَوَسِّمِينَ"},"juz":14,"page":266,"sajda":false},{"number":76,"text":{"ar":"وَإِنَّهَا لَبِسَبِيلٖ مُّقِيمٍ"},"juz":14,"page":266,"sajda":false},{"number":77,"text":{"ar":"إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لِّلۡمُؤۡمِنِينَ"},"juz":14,"page":266,"sajda":false},{"number":78,"text":{"ar":"وَإِن كَانَ أَصۡحَٰبُ ٱلۡأَيۡكَةِ لَظَٰلِمِينَ"},"juz":14,"page":266,"sajda":false},{"number":79,"text":{"ar":"فَٱنتَقَمۡنَا مِنۡهُمۡ