NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Root domain used to detect tenant subdomains in middleware.ts.
# Local dev: leave as localhost:3000 and use e.g. demo.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=bustan-alquran.com

# Service-role key - server-only, bypasses RLS. Used by lib/supabase/admin.ts
# (teacher account creation/edits) and the Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing (apps/web/(staff)/billing, /api/stripe/webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
